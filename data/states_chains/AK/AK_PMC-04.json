      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "State, Department of Health & Social Services v. Mullins",
          "citation": "328 P.3d 1038 (Alaska 2014)",
          "court": "Supreme Court of Alaska",
          "year": 2014,
          "date_decided": "2014-06-27",
          "holding": "A jury verdict holding OCS responsible for 95% of the damages suffered by two sisters abused by grandparents while in OCS legal custody was set aside as irrational, and OCS was granted a new trial on allocation of fault.",
          "relevance": "Shows that tort litigation, not a fatality-review process, has been the main public airing of OCS supervision failures in Alaska.",
          "quote": "Because the evidence supporting the jury's allocation of fault was so insubstantial as to make the verdict plainly unreasonable, we conclude that OCS is entitled to a new trial.",
          "url": "https://www.courtlistener.com/opinion/2680821/state-department-of-health-social-services-v-mullins/",
          "courtlistener_cluster_id": 2680821
        },
        {
          "case_name": "Reasner v. State, Department of Health & Social Services, Office of Children's Services",
          "citation": "394 P.3d 610 (Alaska 2017)",
          "court": "Supreme Court of Alaska",
          "year": 2017,
          "date_decided": "2017-05-19",
          "holding": "Summary judgment against a former foster child who sued OCS over years of sexual abuse was vacated because a genuine factual dispute existed about when she discovered OCS's possible role, though her claim did not qualify for the extended limitations period of AS 09.10.065(a).",
          "relevance": "Illustrates why serious-injury cases surface long after the fact, a gap fatality-review systems are meant to close.",
          "quote": "We conclude that a genuine factual dispute exists concerning when Reasner discovered information suggesting that OCS had played a role in allowing her to be abused.",
          "url": "https://www.courtlistener.com/opinion/4393222/reasner-v-state-department-of-health-social-services-office-of-children-s/",
          "courtlistener_cluster_id": 4393222
        },
        {
          "case_name": "Blake J. v. State, Department of Health & Social Services, Office of Children's Services",
          "citation": "554 P.3d 430 (Alaska 2024)",
          "court": "Supreme Court of Alaska",
          "year": 2024,
          "date_decided": "2024-08-23",
          "holding": "A former foster child's suit over abuse by his adoptive mother was time-barred; neither OCS custody until age 19, collateral estoppel from an earlier guardianship competency ruling, nor equitable tolling saved the claim.",
          "relevance": "Demonstrates that abuse in state-approved homes may never be adjudicated on the merits, leaving fatality and serious-injury review as the only accounting.",
          "quote": "collateral estoppel is not available here because the competency standard in a conservatorship and partial guardianship proceeding is different from the standard of competence necessary to file suit",
          "url": "https://www.courtlistener.com/opinion/10057929/blake-j-v-state-of-alaska-department-of-health-social-services-office-of/",
          "courtlistener_cluster_id": 10057929
        }
