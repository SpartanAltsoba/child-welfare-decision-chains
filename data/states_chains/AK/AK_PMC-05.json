      "key_cases": [
        {
          "case_name": "Basey v. State, Department of Public Safety, Division of Alaska State Troopers",
          "citation": "408 P.3d 1173 (Alaska 2017)",
          "court": "Supreme Court of Alaska",
          "year": 2017,
          "date_decided": "2017-12-29",
          "holding": "The State failed to establish either the AS 40.25.122 litigation exception or the law-enforcement exception to the Alaska Public Records Act, so dismissal of the records requester's suit was error and the case was remanded.",
          "relevance": "Is the leading recent Alaska authority construing the Public Records Act's exceptions narrowly in favor of disclosure.",
          "quote": "We conclude it was error for the superior court to grant the State's motion to dismiss pursuant to AS 40.25.122.",
          "url": "https://www.courtlistener.com/opinion/4456197/basey-v-state-department-of-public-safety-division-of-alaska-state/",
          "courtlistener_cluster_id": 4456197
        },
        {
          "case_name": "Rowan B. v. State, Department of Health & Social Services, Office of Children's Services",
          "citation": "320 P.3d 1152 (Alaska 2014)",
          "court": "Supreme Court of Alaska",
          "year": 2014,
          "date_decided": "2014-03-21",
          "holding": "Civil discovery rules, not the Public Records Act exemptions, govern a CINA parent's request for law-enforcement records, and the trial court erred by denying the request outright instead of conducting an in camera review.",
          "relevance": "Distinguishes public-records requests from party discovery, a distinction any transparency effort in Alaska must respect.",
          "quote": "We hold that the trial court erred in denying Rowan access to materials he sought through discovery without at least conducting an in camera review.",
          "url": "https://www.courtlistener.com/opinion/2657600/rowan-b-v-state-dept-of-health-social-services-office-of-children-s/",
          "courtlistener_cluster_id": 2657600
        },
        {
          "case_name": "Simone H. v. State, Department of Health & Social Services, Office of Children's Services",
          "citation": "320 P.3d 284 (Alaska 2014)",
          "court": "Supreme Court of Alaska",
          "year": 2014,
          "date_decided": "2014-03-07",
          "holding": "The trial court acted within its discretion in refusing to release the child's therapy records to the mother for use at the termination trial, and substantial evidence supported the finding that OCS made reasonable efforts to reunify the family.",
          "relevance": "Shows that child treatment records are a recognized confidentiality boundary any transparency effort must respect.",
          "quote": "We conclude that the trial court acted within its discretion in denying Simone's request for access to Irving's therapy records",
          "url": "https://www.courtlistener.com/opinion/2655918/simone-h-v-state-department-of-health-social-services-office-of-children-s/",
          "courtlistener_cluster_id": 2655918
        }
