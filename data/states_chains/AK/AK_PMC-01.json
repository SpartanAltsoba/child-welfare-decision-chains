      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "State, Department of Family & Community Services, Office of Children's Services v. Z.C.",
          "citation": "Nos. S-18249/18259, Op. No. 7760 (Alaska Mar. 28, 2025)",
          "court": "Supreme Court of Alaska",
          "year": 2025,
          "date_decided": "2025-03-28",
          "holding": "In a class action on behalf of foster children whose Social Security benefits OCS applied to reimburse itself, the court held the due-process claim was not federally preempted and that OCS must give the notice ordered by the superior court if it continues its self-reimbursing representative-payee practice.",
          "relevance": "Identifies a statewide practice affecting every foster child's assets that routine performance monitoring had not remedied.",
          "quote": "We therefore hold that OCS must provide the notice ordered by the superior court if it wishes to continue implementing its self-reimbursing rep payee scheme.",
          "url": "https://www.courtlistener.com/opinion/10635336/state-of-alaska-department-of-health-and-social-services-adam-crum-in-his/",
          "courtlistener_cluster_id": 10635336
        },
        {
          "case_name": "Jacob v. State, Department of Health & Social Services, Office of Children's Services",
          "citation": "177 P.3d 1181 (Alaska 2008)",
          "court": "Supreme Court of Alaska",
          "year": 2008,
          "date_decided": "2008-03-07",
          "holding": "Grandparents were entitled to a declaratory judgment that OCS violated their statutory rights to notice of and participation in their grandchildren's CINA proceedings, but their remaining claims — including the request for systemic injunctive relief — became moot once they intervened.",
          "relevance": "Documents a systemic notice failure of exactly the kind federal performance reviews are meant to detect.",
          "quote": "We hold that all other issues are moot due to the Jacobs' subsequent intervention in their grandchildren's CINA proceedings.",
          "url": "https://www.courtlistener.com/opinion/2561874/jacob-v-state-department-of-health-social-services-office-of-children-s/",
          "courtlistener_cluster_id": 2561874
        },
        {
          "case_name": "State, Department of Health & Social Services, Division of Family & Youth Services v. Native Village of Curyung",
          "citation": "151 P.3d 388 (Alaska 2006)",
          "court": "Supreme Court of Alaska",
          "year": 2006,
          "date_decided": "2006-12-15",
          "holding": "Alaska Native villages may sue the Division's director in his official capacity under section 1983 as parens patriae on behalf of their member children to enforce rights created by the Adoption Assistance Act and ICWA — including the right to a case plan — but may not use section 1983 to enforce rights they hold as sovereigns and may not sue the State directly.",
          "relevance": "Shows that alleged statewide failures to meet federal Title IV-E and ICWA requirements reach a court through tribal section 1983 litigation rather than through CFSR monitoring.",
          "quote": "the villages may bring suit as parens patriae under § 1983 to enforce rights that are created by the Adoption Assistance Act and the Indian Child Welfare Act",
          "url": "https://www.courtlistener.com/opinion/2638298/state-department-of-health-social-services-division-of-family-youth/",
          "courtlistener_cluster_id": 2638298
        }
      ],
