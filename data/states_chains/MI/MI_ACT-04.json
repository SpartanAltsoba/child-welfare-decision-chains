    "case_law": {
      "jurisdiction": "Michigan state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re Mason",
          "citation": "486 Mich. 142, 782 N.W.2d 747 (2010)",
          "court": "Michigan Supreme Court",
          "year": 2010,
          "date_decided": "2010-05-26",
          "holding": "The Court reversed a termination where the incarcerated father was excluded from hearings and his rights were ended essentially because he was in prison, without the court evaluating DHS's efforts or his ability to place the children with relatives.",
          "relevance": "The court must consider whether the parent can provide proper care by voluntarily placing the child with relatives rather than treating relative placement as the agency's alone.",
          "quote": "The mere present inability to personally care for one's children as a result of incarceration does not constitute grounds for termination.",
          "url": "https://www.courtlistener.com/opinion/831254/in-re-mason/",
          "courtlistener_cluster_id": 831254
        },
        {
          "case_name": "In re COH",
          "citation": "495 Mich. 184, 848 N.W.2d 107 (2014)",
          "court": "Michigan Supreme Court",
          "year": 2014,
          "date_decided": "2014-04-22",
          "holding": "The Court held that the relative-placement preference in MCL 722.954a does not apply to a post-termination guardianship determination under MCL 712A.19c(2), and that the trial court permissibly compared placement options using Child Custody Act best-interest factors.",
          "relevance": "The kinship preference in MCL 722.954a governs placement during the case, not the post-termination guardianship choice.",
          "quote": "we hold that there is no preference for placement with relatives as part of a guardianship determination under MCL 712A.19c(2)",
          "url": "https://www.courtlistener.com/opinion/8001639/in-re-coh/",
          "courtlistener_cluster_id": 8001639
        },
        {
          "case_name": "In re Olive/Metts Minors",
          "citation": "297 Mich. App. 35, 823 N.W.2d 144 (2012)",
          "court": "Michigan Court of Appeals",
          "year": 2012,
          "date_decided": "2012-06-05",
          "holding": "The Court affirmed termination as to three children but vacated the best-interest analysis as to twins placed with a relative, holding the trial court must decide best interests for each child individually and must expressly address relative placement.",
          "relevance": "A child's placement with relatives weighs against termination and the court must say on the record that it considered it.",
          "quote": "We hold that the trial court has a duty to decide the best interests of each child individually.",
          "url": "https://www.courtlistener.com/opinion/8006642/in-re-olivemetts-minors/",
          "courtlistener_cluster_id": 8006642
        },
        {
          "case_name": "Bowie v Arder",
          "citation": "441 Mich. 23, 490 N.W.2d 568 (1992)",
          "court": "Michigan Supreme Court",
          "year": 1992,
          "date_decided": "1992-09-22",
          "holding": "The Court held that circuit courts have subject-matter jurisdiction over third-party custody actions under the Child Custody Act but that a third party gains no standing to seek custody merely because the child lives or once lived with him, and that a court exceeds its jurisdiction by transferring custody from a parent where there is no genuine custody dispute.",
          "relevance": "A relative or kin caregiver with whom a child has been placed does not thereby acquire standing to seek custody, so kinship placement alone does not make the caregiver a party who can litigate for the child.",
          "quote": "a third party does not gain standing to petition for custody under the act because a child resides with the third party",
          "url": "https://www.courtlistener.com/opinion/2116959/bowie-v-arder/",
          "courtlistener_cluster_id": 2116959
        }
      ],
