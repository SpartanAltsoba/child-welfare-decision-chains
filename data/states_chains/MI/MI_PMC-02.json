        {
          "case_name": "Michigan Federation of Teachers & School Related Personnel v University of Michigan",
          "citation": "481 Mich. 657, 753 N.W.2d 28 (2008)",
          "court": "Michigan Supreme Court",
          "year": 2008,
          "date_decided": "2008-07-16",
          "holding": "The Court held that public employees' home addresses and telephone numbers satisfy both prongs of FOIA's privacy exemption and are exempt from disclosure because releasing them would reveal little or nothing about the conduct of government.",
          "relevance": "Audit-related records can be released in redacted form, with personal identifiers withheld under the privacy exemption.",
          "quote": "We conclude that employees' home addresses and telephone numbers are information of an embarrassing, intimate, private, or confidential nature.",
          "url": "https://www.courtlistener.com/opinion/839193/michigan-federation-of-teachers-school-related-personnel-v-univer/",
          "courtlistener_cluster_id": 839193
        },
