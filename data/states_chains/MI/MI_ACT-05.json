    "case_law": {
      "jurisdiction": "Michigan state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re Sanders",
          "citation": "495 Mich. 394, 852 N.W.2d 524 (2014)",
          "court": "Michigan Supreme Court",
          "year": 2014,
          "date_decided": "2014-06-02",
          "holding": "The Court held Michigan's one-parent doctrine unconstitutional under the Fourteenth Amendment, so a court may not enter dispositional orders infringing a parent's rights until that parent has been individually adjudicated unfit, and overruled In re CR.",
          "relevance": "Protective or no-contact orders directed at a parent require a prior adjudication of that parent's unfitness, not merely jurisdiction over the child.",
          "quote": "due process requires a specific adjudication of a parent's unfitness before the state can infringe the constitutionally protected parent-child relationship",
          "url": "https://www.courtlistener.com/opinion/8001640/in-re-sanders/",
          "courtlistener_cluster_id": 8001640
        },
        {
          "case_name": "In re Macomber",
          "citation": "436 Mich. 386 (1990)",
          "court": "Michigan Supreme Court",
          "year": 1990,
          "date_decided": "1990-09-26",
          "holding": "The Court held that chapter XIIA gives the probate court broad authority to enter orders affecting adults, including an order requiring a parent to leave the home, where such orders are necessary for the well-being of a child within the court's jurisdiction.",
          "relevance": "Macomber is the Michigan authority for a protective order removing the offending adult from the home instead of removing the child.",
          "quote": "we hold that the Legislature has conferred very broad authority to the probate court",
          "url": "https://www.courtlistener.com/opinion/8000356/kent-county-department-of-social-services-v-macomber/",
          "courtlistener_cluster_id": 8000356
        },
        {
          "case_name": "In re AMB",
          "citation": "248 Mich. App. 144, 640 N.W.2d 262 (2002)",
          "court": "Michigan Court of Appeals",
          "year": 2002,
          "date_decided": "2002-01-25",
          "holding": "The Court held the family court's ex parte and referee proceedings authorizing withdrawal of an infant's life support were fatally defective, that inadequate notice to a respondent is a jurisdictional defect, and it set out the notice, evidentiary and decision-maker standards such a case requires.",
          "relevance": "Orders restricting a parent's decision-making authority require the same notice and hearing as any other dispositional order.",
          "quote": "The absence of this notice to a respondent in a protective proceeding constitutes a jurisdictional defect.",
          "url": "https://www.courtlistener.com/opinion/1712181/in-re-amb/",
          "courtlistener_cluster_id": 1712181
        },
        {
          "case_name": "In re CR",
          "citation": "250 Mich. App. 185, 646 N.W.2d 506 (2002)",
          "court": "Michigan Court of Appeals",
          "year": 2002,
          "date_decided": "2002-05-31",
          "holding": "The Court affirmed the termination of an unadjudicated father's parental rights, holding that the court rules do not require the agency to plead and prove an adjudication against every parent before the family court may act in its dispositional capacity — the one-parent doctrine the Michigan Supreme Court held unconstitutional in In re Sanders (2014).",
          "relevance": "OVERRULED BY SANDERS: CR allowed dispositional orders restricting a parent who was never adjudicated, which is precisely the practice Sanders held violates due process.",
          "quote": "making it possible, under the proper circumstances, to terminate parental rights even of a parent who, for one reason or another, has not participated in the protective proceeding",
          "url": "https://www.courtlistener.com/opinion/2013344/in-re-cr/",
          "courtlistener_cluster_id": 2013344
        }
      ],
