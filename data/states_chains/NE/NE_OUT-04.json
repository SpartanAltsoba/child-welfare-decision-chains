        {
          "case_name": "Calkins ex rel. Antonio S. v. Nebraska Department of Health & Human Services",
          "citation": "270 Neb. 792, 708 N.W.2d 614 (2005)",
          "court": "Nebraska Supreme Court",
          "year": 2005,
          "date_decided": "2005-12-23",
          "holding": "The court held that duly appointed guardians take both care and custody of the children and that the juvenile court did not err in relieving DHHS of custody, case management and supervision, even though that ended the children's prospective eligibility for the State's former ward program.",
          "relevance": "This is the Nebraska Supreme Court's treatment of the former ward program — the State's transitional supports for youth leaving care — and of the trade-off between guardianship permanency and continued eligibility.",
          "quote": "did not err in ordering that Marlin and Sharon, as duly appointed guardians, shall have the care and custody of Priscilla and Antonio",
          "url": "https://www.courtlistener.com/opinion/1313741/calkins-ex-rel-antonio-s-v-nebraska-department-of-health-human/",
          "courtlistener_cluster_id": 1313741
        },
        {
          "case_name": "In re Interest of Mekhi S.",
          "citation": "309 Neb. 529, 960 N.W.2d 732 (2021)",
          "court": "Nebraska Supreme Court",
          "year": 2021,
          "date_decided": "2021-06-18",
          "holding": "The court held that a juvenile court retains jurisdiction over a child after placing the child in a guardianship, so it had authority to entertain the guardian ad litem's motion to terminate the disrupted guardianship and return the children to DHHS custody.",
          "relevance": "Retained jurisdiction after a permanency order is the structural predicate for continued agency responsibility for an older youth.",
          "quote": "the parents' rights have not been terminated, and Nebraska jurisprudence dictates that a juvenile court retains jurisdiction over a juvenile after it places the child in a guardianship",
          "url": "https://www.courtlistener.com/opinion/5092727/in-re-interest-of-mekhi-s/",
          "courtlistener_cluster_id": 5092727
        }
