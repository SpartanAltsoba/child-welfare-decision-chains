      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re Interest of Jeremy U.",
          "citation": "304 Neb. 734, 936 N.W.2d 733 (2020)",
          "court": "Nebraska Supreme Court",
          "year": 2020,
          "date_decided": "2020-01-03",
          "holding": "The court held that 'lacks proper parental care' in § 43-247(3)(a) refers to the type and nature of the care a child is receiving rather than to who provides it, so the two children living safely with grandparents could not be adjudicated on that ground, while the child living with the mother should have been adjudicated.",
          "relevance": "It marks the line between facts that warrant State intervention and facts that do not, which is the substance of a screen-out or unfounded determination.",
          "quote": "We conclude that \"parental\" as used in the phrase \"lacks proper parental care\" describes the type and nature of care rather than the relationship of the person providing it.",
          "url": "https://www.courtlistener.com/opinion/4739802/in-re-interest-of-jeremy-u/",
          "courtlistener_cluster_id": 4739802
        },
        {
          "case_name": "Shearer v. Leuenberger",
          "citation": "256 Neb. 566, 591 N.W.2d 762 (1999)",
          "court": "Nebraska Supreme Court",
          "year": 1999,
          "date_decided": "1999-04-02",
          "holding": "The court held that the child abuse immunity provision of Neb. Rev. Stat. § 28-716 gives the Department's director and investigator state-law immunity for placing a mother's name on the Abused or Neglected Child Registry but does not reach a claim advanced under 42 U.S.C. § 1983, and affirmed dismissal because the Department and its officials in their official capacities are not 'persons' under § 1983 and the registry procedures used violated no clearly established right.",
          "relevance": "The court sets out the four statutory case-status classifications under § 28-720 — court substantiated, petition to be filed, investigation inconclusive, and unfounded report — and the command that identifying information in unfounded reports be expunged forthwith.",
          "quote": "the immunity from liability under state law provided by § 28-716 does not apply to a claim advanced under federal law",
          "url": "https://www.courtlistener.com/opinion/1313347/shearer-v-leuenberger/",
          "courtlistener_cluster_id": 1313347
        },
        {
          "case_name": "Benitez v. Rasmussen",
          "citation": "261 Neb. 806, 626 N.W.2d 209 (2001)",
          "court": "Nebraska Supreme Court",
          "year": 2001,
          "date_decided": "2001-05-18",
          "holding": "The court held that in a hearing under Neb. Rev. Stat. § 28-723 to expunge, amend, or remove a Central Registry report the Department must prove the report's accuracy and consistency by a preponderance of the evidence, that the child-care provider had no protected property interest in her license and no cognizable procedural due process or equal protection claim, and affirmed the refusal to expunge her court-substantiated report.",
          "relevance": "It distinguishes the 'unfounded report' and 'investigation inconclusive' classifications from court-substantiated reports and explains that the Department applies different good-cause criteria to expungement of each.",
          "quote": "the Department must prove the accuracy and consistency of a Registry report of child abuse or neglect by a preponderance of the evidence",
          "url": "https://www.courtlistener.com/opinion/1611751/benitez-v-rasmussen/",
          "courtlistener_cluster_id": 1611751
        }
