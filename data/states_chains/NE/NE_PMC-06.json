          "citation": "455 U.S. 745 (1982)",
          "court": "Supreme Court of the United States",
          "year": 1982,
          "date_decided": "1982-02-22",
          "holding": "The Court held that before a State may irrevocably terminate parental rights, due process under the Fourteenth Amendment requires proof by at least clear and convincing evidence; a fair preponderance standard is unconstitutional.",
          "relevance": "It is one of the fixed constitutional benchmarks against which a state's termination practice can be systematically scored.",
          "quote": "due process requires that the State support its allegations by at least clear and convincing evidence",
          "url": "https://www.courtlistener.com/opinion/110676/santosky-v-kramer/",
          "courtlistener_cluster_id": 110676
        },
        {
          "case_name": "Suter v. Artist M.",
          "citation": "503 U.S. 347 (1992)",
          "court": "Supreme Court of the United States",
          "year": 1992,
          "date_decided": "1992-03-25",
          "holding": "The Court held that the Adoption Assistance and Child Welfare Act's requirement that States make 'reasonable efforts' to prevent removal and reunify families creates no privately enforceable right under § 1983 or directly under the Act.",
          "relevance": "It defines the legal channel through which federal child welfare standards actually bind a state agency.",
          "quote": "We hold that the Act does not create an enforceable right on behalf of respondents.",
          "url": "https://www.courtlistener.com/opinion/112712/suter-v-artist-m/",
          "courtlistener_cluster_id": 112712
        },
        {
          "case_name": "DeShaney v. Winnebago County Department of Social Services",
          "citation": "489 U.S. 189 (1989)",
          "court": "Supreme Court of the United States",
          "year": 1989,
          "date_decided": "1989-02-22",
          "holding": "The Court held that the Due Process Clause imposes no affirmative constitutional duty on a State to protect a child from violence by a private actor, even where the agency knew of the danger and had intervened, absent a custodial restraint on the child's liberty.",
          "relevance": "It marks the outer constitutional limit on holding a child welfare system legally responsible for failure to protect.",
          "quote": "its language cannot fairly be extended to impose an affirmative obligation on the State to ensure that those interests do not come to harm through other means",
          "url": "https://www.courtlistener.com/opinion/112202/deshaney-v-winnebago-county-department-of-social-services/",
          "courtlistener_cluster_id": 112202
        }
      ],
