    "case_law": {
      "jurisdiction": "Nebraska state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re Interest of B.B.",
          "citation": "29 Neb. App. 1, 951 N.W.2d 526 (2020)",
          "court": "Nebraska Court of Appeals",
          "year": 2020,
          "date_decided": "2020-10-13",
          "holding": "The court held that the reporter-immunity provision of Neb. Rev. Stat. § 28-716 protects a person who makes a mandated child abuse or neglect report from civil or criminal liability but does not bar the juvenile court from acquiring jurisdiction over the reporting parent and her children under § 43-247(3)(a).",
          "relevance": "The § 28-716 immunity the court construes runs to 'any person participating in ... the making of a report,' not only to listed professionals, which is the legal footing for voluntary third-party reports.",
          "quote": "they are designed to compel notification of child abuse or neglect to proper authorities in order to place such children and their parents under the supervision of the juvenile court",
          "url": "https://www.courtlistener.com/opinion/4798208/in-re-interest-of-bb/",
          "courtlistener_cluster_id": 4798208
        },
        {
          "case_name": "Shearer v. Leuenberger",
          "citation": "256 Neb. 566, 591 N.W.2d 762 (1999)",
          "court": "Nebraska Supreme Court",
          "year": 1999,
          "date_decided": "1999-04-02",
          "holding": "The court held that the child abuse immunity provision of Neb. Rev. Stat. § 28-716 gives the Department's director and investigator state-law immunity for placing a mother's name on the Abused or Neglected Child Registry but does not reach a claim advanced under 42 U.S.C. § 1983, and affirmed dismissal because the Department and its officials in their official capacities are not 'persons' under § 1983 and the registry procedures used violated no clearly established right.",
          "relevance": "The § 28-716 immunity the court construes runs to 'any person participating in an investigation or the making of a report,' which is the same provision that shields a non-mandated third-party reporter, and the court fixes its outer limit at maliciously false statements.",
          "quote": "the immunity from liability under state law provided by § 28-716 does not apply to a claim advanced under federal law",
          "url": "https://www.courtlistener.com/opinion/1313347/shearer-v-leuenberger/",
          "courtlistener_cluster_id": 1313347
        }
      ],
