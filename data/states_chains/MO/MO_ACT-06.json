      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Norfleet ex rel. Norfleet v. Arkansas Department of Human Services",
          "citation": "989 F.2d 289 (8th Cir. 1993)",
          "court": "United States Court of Appeals for the Eighth Circuit",
          "year": 1993,
          "date_decided": "1993-03-29",
          "holding": "The Eighth Circuit affirmed the denial of qualified immunity, holding that placing a child in foster care creates a custodial relationship and that it was clearly established that the state then owes the child adequate medical care, protection and supervision under the Due Process Clause.",
          "relevance": "The case arose from a foster child's death after his medication was not supervised, and it establishes the state's duty to provide adequate medical care in placement.",
          "quote": "In foster care, a child loses his freedom and ability to make decisions about his own welfare, and must rely on the state to take care of his needs.",
          "url": "https://www.courtlistener.com/opinion/9015856/norfleet-ex-rel-norfleet-v-arkansas-department-of-human-services/",
          "courtlistener_cluster_id": 9015856
        },
        {
          "case_name": "James v. Friend",
          "citation": "458 F.3d 726 (8th Cir. 2006)",
          "court": "United States Court of Appeals for the Eighth Circuit",
          "year": 2006,
          "date_decided": "2006-08-10",
          "holding": "In the case arising from the death of Dominic James in Missouri foster care, the Eighth Circuit affirmed summary judgment for the caseworkers, holding that although foster placement creates a custodial relationship, a substantive due process violation requires conscience-shocking conduct or deliberate indifference, and that the decision not to move the child immediately was a discretionary act protected by official immunity.",
          "relevance": "The child's hospitalization, seizure and unexplained bruising, and the agency's response, are the facts on which the medical-care duty was litigated.",
          "quote": "A custodial relationship is created when a child is placed in foster care.",
          "url": "https://www.courtlistener.com/opinion/795306/sidney-james-on-behalf-of-dominic-james-deceased-and-on-his-own-behalf/",
          "courtlistener_cluster_id": 795306
        }
      ],
