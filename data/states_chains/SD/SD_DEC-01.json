          "case_name": "Cotton v. Stange",
          "citation": "1998 S.D. 81, 582 N.W.2d 25",
          "court": "South Dakota Supreme Court",
          "year": 1998,
          "date_decided": "1998-07-22",
          "holding": "The court reversed the denial of summary judgment and ordered judgment for two DSS social workers, holding they were immune under SDCL 26-8A-14 because the children produced only evidence of negligent investigation, not of bad faith.",
          "relevance": "This is the controlling South Dakota authority on liability for screening out or under-investigating referrals - only bad faith, not error, is actionable.",
          "quote": "These circumstances might amount to negligence but they do not equate with bad faith.",
          "url": "https://www.courtlistener.com/opinion/900289/cotton-v-stange/",
          "courtlistener_cluster_id": 900289
        },
        {
          "case_name": "DuBray v. South Dakota Department of Social Services",
          "citation": "2004 S.D. 130, 690 N.W.2d 657",
          "court": "South Dakota Supreme Court",
          "year": 2004,
          "date_decided": "2004-12-15",
          "holding": "The court affirmed reversal of a central registry listing, holding that DSS's exclusive reliance on an intake worksheet, a police incident report and a DSS narrative - all inadmissible hearsay - deprived DuBray of a meaningful due process hearing.",
          "relevance": "It marks the evidentiary line between an unreviewable internal screening judgment and a substantiation that must survive a contested hearing.",
          "quote": "the admission of such evidence deprived DuBray of her fundamental right to a meaningful, due process hearing",
          "url": "https://www.courtlistener.com/opinion/1294715/dubray-v-south-dakota-dept-of-social-services/",
          "courtlistener_cluster_id": 1294715
        },
        {
          "case_name": "Pfuhl v. Pfuhl",
          "citation": "2014 S.D. 25, 846 N.W.2d 778",
          "court": "South Dakota Supreme Court",
          "year": 2014,
          "date_decided": "2014-04-30",
          "holding": "The court reversed an order directing the county to pay court-appointed counsel in a protection order proceeding, holding SDCL 26-8A-18 authorizes county payment only in proceedings whose particular subject is a child's status or condition as abused or neglected.",
          "relevance": "DSS investigated the same allegations and found no evidence of abuse, and law enforcement declined charges - the unfounded outcome in practice.",
          "quote": "the circuit court lacked statutory authority in this case to order Minnehaha to pay appointed counsel's costs",
          "url": "https://www.courtlistener.com/opinion/2713901/pfuhl-v-pfuhl/",
          "courtlistener_cluster_id": 2713901
        },
        {
          "case_name": "L.S. v. C.T.",
          "citation": "2009 S.D. 2, 760 N.W.2d 145",
          "court": "South Dakota Supreme Court",
          "year": 2009,
          "date_decided": "2009-01-14",
          "holding": "The court affirmed denial of a protection order and of a request to restrict visitation, holding the circuit court was not clearly erroneous in finding that the mother had failed to prove by a preponderance of the evidence that the father sexually abused their child.",
          "relevance": "Three South Dakota CPS investigations and two Nebraska investigations were all closed as 'unsubstantiated' or 'unfounded,' showing the screen-out and unfounded outcome as it actually reaches a court.",
          "quote": "Under SDCL 25-10-5, a circuit court may grant a protection order if it finds by a preponderance of the evidence that abuse has occurred.",
          "url": "https://www.courtlistener.com/opinion/8279753/ls-v-ct/",
          "courtlistener_cluster_id": 8279753
        }
