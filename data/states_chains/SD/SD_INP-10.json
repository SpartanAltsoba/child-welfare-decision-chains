      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "DuBray v. South Dakota Department of Social Services",
          "citation": "2004 S.D. 130, 690 N.W.2d 657",
          "court": "South Dakota Supreme Court",
          "year": 2004,
          "date_decided": "2004-12-15",
          "holding": "The court affirmed reversal of a central registry listing, holding that DSS's exclusive reliance on an intake worksheet, a police incident report and a DSS narrative - all inadmissible hearsay - deprived DuBray of a meaningful due process hearing.",
          "relevance": "It shows what happens when a screened-in report is substantiated on paper alone without producing the workers or officers who gathered the facts.",
          "quote": "the admission of such evidence deprived DuBray of her fundamental right to a meaningful, due process hearing",
          "url": "https://www.courtlistener.com/opinion/1294715/dubray-v-south-dakota-dept-of-social-services/",
          "courtlistener_cluster_id": 1294715
        },
        {
          "case_name": "Small v. State",
          "citation": "2003 S.D. 29, 659 N.W.2d 15",
          "court": "South Dakota Supreme Court",
          "year": 2003,
          "date_decided": "2003-03-12",
          "holding": "The court affirmed dismissal of a declaratory judgment action attacking a central registry listing, holding that the SDCL 26-8A-11 administrative decision had to be appealed under SDCL ch. 1-26 and that the failure to do so was a jurisdictional defect.",
          "relevance": "It maps the statutory route from a substantiated investigation through informal review to a contested administrative hearing under SDCL 26-8A-11.",
          "quote": "The Smalls' decision not to appeal pursuant to SDCL ch 1-26 deprived the circuit court of jurisdiction.",
          "url": "https://www.courtlistener.com/opinion/901134/small-v-state/",
          "courtlistener_cluster_id": 901134
        },
        {
          "case_name": "In re M.V.",
          "citation": "2011 S.D. 81, 808 N.W.2d 916",
          "court": "South Dakota Supreme Court",
          "year": 2011,
          "date_decided": "2011-12-07",
          "holding": "The court affirmed an abuse and neglect adjudication of an infant with non-accidental head trauma, holding the adjudication concerns the child's status so no parent-specific findings were required, and that a parent's remedy for an erroneous central registry listing lies with the Department, not the juvenile court.",
          "relevance": "It explains how a hospital report escalates into protective custody and a filed petition, and what findings that escalation does and does not require.",
          "quote": "Mother's remedy is with the Department rather than the juvenile court that is adjudicating the status of the child",
          "url": "https://www.courtlistener.com/opinion/8246039/in-re-mv/",
          "courtlistener_cluster_id": 8280442
        }
      ],
