          "case_name": "People ex rel. J.S.B., Jr.",
          "citation": "2005 S.D. 3, 691 N.W.2d 611",
          "court": "South Dakota Supreme Court",
          "year": 2005,
          "date_decided": "2005-01-05",
          "holding": "The court held that ASFA's aggravated-circumstances exception to reasonable efforts does not override ICWA's active efforts requirement, but affirmed termination because DSS in fact continued to provide active efforts that proved unsuccessful.",
          "relevance": "The court treated a signed, voluntary Family Service Agreement offered in jail as satisfying the active efforts obligation.",
          "quote": "Under ICWA, DSS was bound by law to make \"active efforts\" to reunite J.S.B with his father, but it was not required to persist with futile efforts.",
          "url": "https://www.courtlistener.com/opinion/901424/the-people-of-the-state-of-south-dakota-in-the-interest-of-jsb-jr/",
          "courtlistener_cluster_id": 901424
        },
        {
          "case_name": "In re S.A.",
          "citation": "2005 S.D. 120, 708 N.W.2d 673",
          "court": "South Dakota Supreme Court",
          "year": 2005,
          "date_decided": "2005-12-07",
          "holding": "The court affirmed the adjudication and termination, holding that the State proved abuse and neglect by clear and convincing evidence and that DSS need not exhaust every possible form of assistance before termination becomes the least restrictive alternative.",
          "relevance": "The parents' participation in offered counseling and services is weighed here as part of the reasonable-efforts and least-restrictive-alternative analysis.",
          "quote": "The State has the burden of proving that the children were abused or neglected by clear and convincing evidence.",
          "url": "https://www.courtlistener.com/opinion/8244988/in-re-sa/",
          "courtlistener_cluster_id": 8279610
        },
        {
          "case_name": "Interest of L.N.",
          "citation": "2022 S.D. 8",
          "court": "South Dakota Supreme Court",
          "year": 2022,
          "date_decided": "2022-02-09",
          "holding": "The court affirmed termination of parental rights, holding that active efforts were provided, that termination was the least restrictive alternative, and that proceeding while the mother was mentally incompetent did not, on these facts and under the Mathews factors, violate due process.",
          "relevance": "The opinion catalogues the voluntary services offered to the parents and treats their refusal as central to the active-efforts finding.",
          "quote": "Under the circumstances presented here, the circuit court did not violate Mother's due process rights in denying her request to continue the final dispositional hearing.",
          "url": "https://www.courtlistener.com/opinion/9974680/interest-of-ln/",
          "courtlistener_cluster_id": 9508067
        }
