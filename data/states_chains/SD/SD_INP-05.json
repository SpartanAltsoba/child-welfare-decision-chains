      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "People ex rel. A.B.",
          "citation": "2016 S.D. 44, 880 N.W.2d 95",
          "court": "South Dakota Supreme Court",
          "year": 2016,
          "date_decided": "2016-05-18",
          "holding": "The court remanded a termination of parental rights because the circuit court never made the 25 U.S.C. 1912(f) finding, beyond a reasonable doubt, that the mother's continued custody would likely cause serious emotional or physical damage to the Indian child.",
          "relevance": "The case began when the mother herself contacted DSS about suspected abuse of her daughter, the self-report pathway, and the agency's response then turned on her.",
          "quote": "The court erred when it terminated Mother's parental rights without conducting this necessary examination utilizing the proper standard of proof.",
          "url": "https://www.courtlistener.com/opinion/3204901/people-ex-rel-ab/",
          "courtlistener_cluster_id": 3205007
        },
        {
          "case_name": "Cotton v. Stange",
          "citation": "1998 S.D. 81, 582 N.W.2d 25",
          "court": "South Dakota Supreme Court",
          "year": 1998,
          "date_decided": "1998-07-22",
          "holding": "The court reversed the denial of summary judgment and ordered judgment for two DSS social workers, holding they were immune under SDCL 26-8A-14 because the children produced only evidence of negligent investigation, not of bad faith.",
          "relevance": "The referrals here came from within the family's orbit, and the case sets what a family must later prove to hold the responding workers liable.",
          "quote": "These circumstances might amount to negligence but they do not equate with bad faith.",
          "url": "https://www.courtlistener.com/opinion/900289/cotton-v-stange/",
          "courtlistener_cluster_id": 900289
        },
        {
          "case_name": "Interest of M.S. & K.S.",
          "citation": "2014 S.D. 17, 845 N.W.2d 366",
          "court": "South Dakota Supreme Court",
          "year": 2014,
          "date_decided": "2014-04-02",
          "holding": "The court affirmed termination, holding the circuit court did not clearly err in finding that further reasonable efforts would be futile and that statutory good cause under SDCL 26-8A-21.1 and 26-8A-26.1 justified terminating the parents' rights.",
          "relevance": "DSS involvement began with a treatment-provider referral about the mother's prenatal substance use, a front-end help-seeking contact that escalated.",
          "quote": "the court had sufficient evidence and reasoning to find Mother's efforts futile when considering the children's best interests",
          "url": "https://www.courtlistener.com/opinion/2713909/interest-of-ms-ks/",
          "courtlistener_cluster_id": 2713909
        }
      ],
