    "case_law": {
      "jurisdiction": "South Dakota state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "B.W. v. Meade County",
          "citation": "534 N.W.2d 595 (S.D. 1995)",
          "court": "South Dakota Supreme Court",
          "year": 1995,
          "date_decided": "1995-07-19",
          "holding": "The court affirmed summary judgment for a deputy sheriff and a DSS social worker, holding that SDCL 26-8A-14 immunizes public officials involved in child abuse reporting and investigation and that mere negligence in the investigation does not defeat the statute's good-faith requirement.",
          "relevance": "This is South Dakota's leading construction of the SDCL 26-8A-14 immunity that protects mandatory reporters and the officials who act on their reports, and it fixes good faith - not due care - as the operative test.",
          "quote": "Within the bounds of our statute, negligence and lack of good faith are not equivalent.",
          "url": "https://www.courtlistener.com/opinion/1700429/bw-v-meade-county/",
          "courtlistener_cluster_id": 1700429
        },
        {
          "case_name": "Cotton v. Stange",
          "citation": "1998 S.D. 81, 582 N.W.2d 25",
          "court": "South Dakota Supreme Court",
          "year": 1998,
          "date_decided": "1998-07-22",
          "holding": "The court reversed the denial of summary judgment and ordered judgment for two DSS social workers, holding they were immune under SDCL 26-8A-14 because the children produced only evidence of negligent investigation, not of bad faith.",
          "relevance": "It confirms that the SDCL 26-8A-14 good-faith shield covers the caseworkers who receive and act on referrals, not just the person who makes the report.",
          "quote": "These circumstances might amount to negligence but they do not equate with bad faith.",
          "url": "https://www.courtlistener.com/opinion/900289/cotton-v-stange/",
          "courtlistener_cluster_id": 900289
        },
        {
          "case_name": "E.P. v. Riley",
          "citation": "1999 S.D. 163, 604 N.W.2d 7",
          "court": "South Dakota Supreme Court",
          "year": 1999,
          "date_decided": "1999-12-29",
          "holding": "The court held that DSS employees owed a common law duty to protect a child from a foster child with known dangerous propensities and reversed summary judgment because fact issues remained on whether the employees acted in good faith under SDCL 26-8A-14.",
          "relevance": "The opinion sets out the full text and reach of SDCL 26-8A-14, the immunity provision that anchors South Dakota's mandatory reporting scheme.",
          "quote": "it is clear the immunity provisions of SDCL 26-8A-14 apply to the placement activities of DSS employees involving JH",
          "url": "https://www.courtlistener.com/opinion/900372/ep-v-riley/",
          "courtlistener_cluster_id": 900372
        },
        {
          "case_name": "In re S.A.",
          "citation": "2005 S.D. 120, 708 N.W.2d 673",
          "court": "South Dakota Supreme Court",
          "year": 2005,
          "date_decided": "2005-12-07",
          "holding": "The court affirmed the adjudication and termination, holding that the State proved abuse and neglect by clear and convincing evidence and that DSS need not exhaust every possible form of assistance before termination becomes the least restrictive alternative.",
          "relevance": "The case began when a school principal observed marks on a child and called DSS, the paradigm mandatory-reporter chain in South Dakota.",
          "quote": "The State has the burden of proving that the children were abused or neglected by clear and convincing evidence.",
          "url": "https://www.courtlistener.com/opinion/8244988/in-re-sa/",
          "courtlistener_cluster_id": 8279610
        }
      ],
