      "key_cases": [
        {
          "case_name": "In re Appeal of T.O. & L.O.",
          "citation": "2021 VT 41, 257 A.3d 240",
          "court": "Supreme Court of Vermont",
          "year": 2021,
          "date_decided": "2021-06-11",
          "holding": "The Human Services Board lacked jurisdiction over grandparents' claim that DCF failed to comply with state and federal relative-placement requirements; their remedy lies in the family division of the superior court, and no due process violation resulted.",
          "relevance": "It shows that failures to meet federally funded placement conditions are not redressable through Vermont's administrative fair-hearing system.",
          "quote": "That procedure is access to the family division, not to the Human Services Board.",
          "url": "https://www.courtlistener.com/opinion/4890927/in-re-appeal-of-to-lo/",
          "courtlistener_cluster_id": 4890927
        },
        {
          "case_name": "Toensing v. Attorney Gen. of Vt.",
          "citation": "178 A.3d 1000 (Vt. 2017)",
          "court": "Supreme Court of Vermont",
          "year": 2017,
          "date_decided": "2017-10-20",
          "holding": "Records produced or acquired in the course of agency business are public records under the Public Records Act even when they sit in employees' private accounts, and where a requester specifically seeks such communications the agency must ask the named employees to produce them.",
          "relevance": "Financial and audit records held by state officials are reachable under the PRA even in personal accounts if they meet the public-record definition.",
          "quote": "the PRA's definition of \"public record\" includes digital documents stored in private accounts, but emphasize that it extends only to documents that otherwise meet the definition of public records",
          "url": "https://www.courtlistener.com/opinion/6483671/toensing-v-attorney-gen-of-vt/",
          "courtlistener_cluster_id": 6483671
        },
        {
          "case_name": "In re D.F., H.F., M.F. and D.F., Juveniles",
          "citation": "2018 VT 132, 204 A.3d 641",
          "court": "Supreme Court of Vermont",
          "year": 2018,
          "date_decided": "2018-12-14",
          "holding": "Termination of the father's rights was affirmed notwithstanding his completion of case-plan tasks, and his separate challenge to the standalone reasonable-efforts finding was dismissed as moot once termination was upheld.",
          "relevance": "It is the Vermont Supreme Court's own statement that these judicial findings exist to protect the federal funding stream, which is what a financial audit would trace.",
          "quote": "A reasonable-efforts finding is essential to preserving federal funding for state child-welfare programs.",
          "url": "https://www.courtlistener.com/opinion/4573483/in-re-df-hf-mf-and-df-juveniles/",
          "courtlistener_cluster_id": 4573483
        }
