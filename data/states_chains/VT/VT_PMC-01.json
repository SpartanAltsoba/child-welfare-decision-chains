      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "In re D.F., H.F., M.F. and D.F., Juveniles",
          "citation": "2018 VT 132, 204 A.3d 641",
          "court": "Supreme Court of Vermont",
          "year": 2018,
          "date_decided": "2018-12-14",
          "holding": "Termination of the father's rights was affirmed notwithstanding his completion of case-plan tasks, and his separate challenge to the standalone reasonable-efforts finding was dismissed as moot once termination was upheld.",
          "relevance": "The opinion ties the Vermont reasonable-efforts hearing directly to 42 U.S.C. § 671(a)(15), the federal performance requirement.",
          "quote": "A reasonable-efforts finding is essential to preserving federal funding for state child-welfare programs.",
          "url": "https://www.courtlistener.com/opinion/4573483/in-re-df-hf-mf-and-df-juveniles/",
          "courtlistener_cluster_id": 4573483
        },
        {
          "case_name": "In re C.P.",
          "citation": "2012 VT 100, 193 Vt. 29, 71 A.3d 1142",
          "court": "Supreme Court of Vermont",
          "year": 2012,
          "date_decided": "2012-12-07",
          "holding": "Termination was affirmed; a reasonable-efforts finding is a separate determination from the best-interests inquiry and is not a precondition to terminating parental rights, although the level of assistance given to parents remains relevant to whether they can resume parenting in a reasonable time.",
          "relevance": "The reasonable-efforts determination C.P. describes is the judicial finding that federal reviews and Title IV-E funding depend on.",
          "quote": "the court is not required to find DCF made reasonable efforts as a prerequisite to termination",
          "url": "https://www.courtlistener.com/opinion/1043661/in-re-c-p/",
          "courtlistener_cluster_id": 1043661
        },
        {
          "case_name": "In re Appeal of T.O. & L.O.",
          "citation": "2021 VT 41, 257 A.3d 240",
          "court": "Supreme Court of Vermont",
          "year": 2021,
          "date_decided": "2021-06-11",
          "holding": "The Human Services Board lacked jurisdiction over grandparents' claim that DCF failed to comply with state and federal relative-placement requirements; their remedy lies in the family division of the superior court, and no due process violation resulted.",
          "relevance": "The relative-notice obligations at issue are conditions on federal child-welfare aid, making this the Vermont decision on their enforceability.",
          "quote": "That procedure is access to the family division, not to the Human Services Board.",
          "url": "https://www.courtlistener.com/opinion/4890927/in-re-appeal-of-to-lo/",
          "courtlistener_cluster_id": 4890927
        }
      ],
