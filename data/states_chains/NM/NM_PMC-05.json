      "key_cases": [
        {
          "case_name": "Pacheco v. Hudson",
          "citation": "415 P.3d 505 (N.M. 2018)",
          "court": "New Mexico Supreme Court",
          "year": 2018,
          "date_decided": "2018-03-05",
          "holding": "The Court held that an Inspection of Public Records Act enforcement action seeking a district court's records must be filed against the lawfully designated IPRA custodian and in the judicial district that maintains the records.",
          "relevance": "It is the controlling procedural framework for an IPRA request and suit, New Mexico's state analogue to FOIA.",
          "quote": "IPRA actions directed at a district court's records must be filed against the lawfully designated IPRA custodian and must be filed in the judicial district that maintains the records",
          "url": "https://www.courtlistener.com/opinion/4474535/pacheco-v-hudson/",
          "courtlistener_cluster_id": 4474535
        },
        {
          "case_name": "San Juan Agricultural Water Users Ass'n v. KNME-TV",
          "citation": "2011-NMSC-011, 150 N.M. 64, 257 P.3d 884",
          "court": "New Mexico Supreme Court",
          "year": 2011,
          "date_decided": "2011-03-08",
          "holding": "The Court held that a principal, disclosed or not, may delegate the making of an Inspection of Public Records Act request to an agent such as counsel, and that either the agent or the principal may sue to enforce the request if it is denied; it reversed the dismissal of the association's claims.",
          "relevance": "It is the New Mexico Supreme Court's controlling statement of who may make and who may enforce an IPRA request, the state analogue to a FOIA requester's right of action.",
          "quote": "a principal, whether disclosed or not, can delegate the function of requesting public records to an agent, such as the principal's attorney",
          "url": "https://www.courtlistener.com/opinion/891702/san-juan-agricultural-water-users-assn-v-knme-tv/",
          "courtlistener_cluster_id": 891702
        },
        {
          "case_name": "Republican Party v. New Mexico Taxation & Revenue Department",
          "citation": "2012-NMSC-026",
          "court": "New Mexico Supreme Court",
          "year": 2012,
          "date_decided": "2012-06-28",
          "holding": "The Court held that New Mexico recognizes only a limited constitutional executive privilege that may be invoked by the Governor alone, and declined to recognize a common-law deliberative process privilege that would shield cabinet agency records from disclosure.",
          "relevance": "It defines the narrow universe of executive-privilege exceptions to New Mexico's public-records regime.",
          "quote": "while the privilege can extend to communications authored by close advisers, the privilege's constitutional foundation requires limiting its invocation to the Governor",
          "url": "https://www.courtlistener.com/opinion/891791/republican-party-v-new-mexico-taxation-revenue-department/",
          "courtlistener_cluster_id": 891791
        }
      ],
