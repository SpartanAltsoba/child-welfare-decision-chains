    "case_law": {
      "jurisdiction": "Idaho state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Wade v. Taylor",
          "citation": "156 Idaho 91, 320 P.3d 1250 (2014)",
          "court": "Idaho Supreme Court",
          "year": 2014,
          "date_decided": "2014-03-18",
          "holding": "Vacating the district court's disclosure order and remanding, the court held that public records are presumed open, that exemptions are narrowly construed, and that the withholding agency bears the burden of demonstrating a reasonable probability that disclosure would cause a harm listed in I.C. § 9-335(1).",
          "relevance": "An agency that withholds without a thorough, record-specific justification has failed its statutory disclosure burden.",
          "quote": "this Court presumes the records to be open to the public, unless it is shown that an exemption applies",
          "url": "https://www.courtlistener.com/opinion/2657056/jamee-lee-wade-v-bryan-f-taylor/",
          "courtlistener_cluster_id": 2657056
        },
        {
          "case_name": "Bolger v. Lance",
          "citation": "137 Idaho 792, 53 P.3d 1211 (2002)",
          "court": "Idaho Supreme Court",
          "year": 2002,
          "date_decided": "2002-06-03",
          "holding": "Affirming denial of a public-records petition, the court held that Idaho public records are presumed open and exemptions narrowly construed, that the agency responding to an order to show cause bears the burden of persuasion to prove an exemption applies, and that the Attorney General carried that burden here through in camera review of the withheld investigatory records.",
          "relevance": "The authority a requester cites when an agency asserts an exemption without proving it, and the case Wade v. Taylor relies on for that burden allocation.",
          "quote": "the agency bears the burden of persuasion and must \"show cause,\" or prove, that the documents fit within one of the narrowly-construed exemptions",
          "url": "https://www.courtlistener.com/opinion/2581839/bolger-v-lance/",
          "courtlistener_cluster_id": 2581839
        },
        {
          "case_name": "Federated Publications, Inc. v. Boise City",
          "citation": "128 Idaho 459, 915 P.2d 21 (1996)",
          "court": "Idaho Supreme Court",
          "year": 1996,
          "date_decided": "1996-04-17",
          "holding": "The court held that the names and resumes of applicants for appointment to a city council are not exempt personnel records because a council member is a local governmental official rather than an employee, and that a police department's administrative review of an officer-involved incident is not an exempt personnel record or performance evaluation, because exemptions to the open-records presumption are narrowly construed.",
          "relevance": "Holds that an agency's internal administrative review of its own personnel's conduct is not automatically an exempt personnel record or performance evaluation.",
          "quote": "In deciding that the administrative review must be disclosed, we are also influenced by the presumption that all public records are open unless expressly provided otherwise by statute",
          "url": "https://www.courtlistener.com/opinion/1310352/federated-publications-inc-v-boise-city/",
          "courtlistener_cluster_id": 1310352
        }
      ],
