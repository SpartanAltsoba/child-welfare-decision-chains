        },
        {
          "case_name": "Mabe v. San Bernardino County, Department of Public Social Services",
          "citation": "237 F.3d 1101 (9th Cir. 2001)",
          "court": "United States Court of Appeals for the Ninth Circuit",
          "year": 2001,
          "date_decided": "2001-01-24",
          "holding": "Reversing summary judgment for the social worker on the removal claim, the court held that exigency requires imminent danger of future harm and that a material fact question existed where the worker had interviewed the child days earlier and left her in the home.",
          "relevance": "A worker who investigates and then leaves the child at home has, by her own conduct, negated the exigency she later claims.",
          "quote": "imminent danger of future harm is required to show exigency",
          "url": "https://www.courtlistener.com/opinion/7086384/mabe-v-san-bernardino-county/",
          "courtlistener_cluster_id": 7086384
        }
