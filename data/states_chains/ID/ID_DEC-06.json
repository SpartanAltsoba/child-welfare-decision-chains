        {
          "case_name": "Idaho Department of Health & Welfare v. John Doe (2023-25)",
          "citation": "No. 50875 (Idaho Nov. 3, 2023)",
          "court": "Idaho Supreme Court",
          "year": 2023,
          "date_decided": "2023-11-03",
          "holding": "Affirming a redisposition order removing five children from a home that had been under protective supervision, the court held for the first time that a redisposition hearing under I.C. § 16-1623 is governed by the same preponderance-of-the-evidence standard as an adjudicatory hearing and does not unconstitutionally interfere with parental rights.",
          "relevance": "Protective supervision with the parents retaining custody is Idaho's statutory alternative to vesting legal custody in the Department.",
          "quote": "The redisposition hearing process is, in essence, another adjudicatory hearing resulting in a \"redisposition\" of the child's custody",
          "url": "https://www.courtlistener.com/opinion/9437138/idhw-v-john-doe/",
          "courtlistener_cluster_id": 9437138
        },
        {
          "case_name": "Roe v. State, Department of Health & Welfare",
          "citation": "134 Idaho 760, 9 P.3d 1226 (2000)",
          "court": "Idaho Supreme Court",
          "year": 2000,
          "date_decided": "2000-09-06",
          "holding": "The court affirmed denial of a grandmother's motion to intervene, holding that the CPA confers no conditional right to intervene, that permissive intervention under I.R.C.P. 24(b)(2) is inconsistent with the CPA, and that once the Department has legal custody it, not the court, decides where the child lives.",
          "relevance": "Sets out the CPA's declared policy of preserving family unity and preferring care in the child's own home.",
          "quote": "Once the Department has legal custody of a child under the CPA, the Department and not the court has the authority to determine where the child should live",
          "url": "https://www.courtlistener.com/opinion/5341894/roe-v-state/",
          "courtlistener_cluster_id": 5341894
        }
      ],
