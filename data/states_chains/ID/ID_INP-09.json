  "notice_requirements": [
    {
      "who_must_be_notified": [
        "parent",
        "legal_guardian"
      ],
      "method": "any_reasonable",
      "timing": "In writing, at the time of or within seventy-two (72) hours after the department makes first contact directly and in person with the parents, guardians, or other persons having legal custody of the child (Idaho Code § 16-1649(2)); the notification must be on a form prescribed by the department (§ 16-1649(4))",
      "content_required": [
        "The right to refuse to answer questions",
        "The right to obtain an attorney at their own expense, consult with that attorney, and have that attorney present during an investigation (the department is not authorized to appoint or obtain an attorney)",
        "The right to refuse entry to their home or other real property",
        "The right to refuse the questioning of any minor children in their home or on their property, unless a court of competent jurisdiction has issued an order authorizing a particular entry, questioning, or examination",
        "A statement that if the safety of the child cannot be determined, the department may request assistance from a law enforcement agency or seek a court order"
      ],
      "defective_notice_consequence": "Failure by the department to provide the notification in a specific investigation shall not affect the department's ability to conduct that investigation or to carry out its duties under the Child Protective Act (Idaho Code § 16-1649(5))",
      "statutory_basis": {
        "citation_text": "Idaho Code § 16-1649 (Notification of rights)",
        "source_url": "https://legislature.idaho.gov/statutesrules/idstat/Title16/T16CH16/SECT16-1649/",
        "authority_type": "state_statute",
        "last_verified": "2026-09-19"
      }
    }
  ],
