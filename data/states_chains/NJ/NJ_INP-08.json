  "state_agency": {
    "name": "New Jersey Division of Child Protection and Permanency",
    "acronym": "CP&P",
    "hotline": "1-877-652-2873",
    "website": "https://www.nj.gov/dcf/"
  },
  "mandatory_reporters": [
    "Any person (universal mandatory reporting) — N.J.S.A. 9:6-8.10"
  ],
  "reporting_type": "centralized",
  "reporting_details": "New Jersey is a universal-reporter state: any person having reasonable cause to believe that a child has been subjected to child abuse must report it immediately to the Division of Child Protection and Permanency through the 24-hour State Central Registry hotline, 1-877-652-2873 (1-877 NJ ABUSE), and may do so anonymously, and any person who fails to report is a disorderly person (N.J.S.A. 9:6-8.10; N.J.S.A. 9:6-8.14).",
  "definitions": {
    "abuse": [
      "Physical abuse",
      "Sexual abuse",
      "Emotional abuse",
      "Excessive punishment",
      "Human trafficking",
      "Failure to protect",
      "Institutional abuse/neglect"
    ],
    "neglect": [
      "General neglect",
      "Medical neglect",
      "Educational neglect",
      "Abandonment",
      "Inadequate supervision",
      "Inadequate shelter/housing",
      "Inadequate clothing",
      "Malnourishment/failure to provide food",
      "Failure to thrive",
      "Injurious environment"
    ],
    "other": [
      "Continued inappropriate placement of a child in an institution with the knowledge that the placement has resulted and may continue to result in harm to the child's mental or physical well-being"
    ],
    "substance_related": [
      "Illicit substance involvement"
    ]
  },
