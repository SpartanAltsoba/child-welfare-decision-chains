  "timeline_requirements": [
    {
      "requirement_name": "Initial response time",
      "deadline": "Immediate (by the end of the work day) or within 24 hours for a child protective services report; within 72 hours or 5 work days for a child welfare service referral",
      "starts_from": "State Central Registry accepts the report and assigns it to the local office for response",
      "source": "admin_rule",
      "source_url": "https://policy.dcf.nj.gov/app/file/CPP-II-C-2-300.pdf",
      "consequence_of_miss": "When contact cannot be made within the assigned timeframe the worker must make and document a good faith effort (CP&P-II-C-2-300(G); CP&P-II-C-5-125)."
    },
    {
      "requirement_name": "Investigation completion",
      "deadline": "60 calendar days (good-cause extensions in 30-day increments)",
      "starts_from": "State Central Registry assigns the CPS report to the local office for response",
      "source": "admin_rule",
      "source_url": "https://policy.dcf.nj.gov/app/file/CPP-II-C-6-200.pdf",
      "consequence_of_miss": "Good cause must be established and an extension approved by the local office manager or designee before day 60 (CP&P-II-C-6-200)."
    }
  ],
