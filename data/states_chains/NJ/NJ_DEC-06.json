          "case_name": "New Jersey Department of Children & Families v. A.L.",
          "citation": "213 N.J. 1, 59 A.3d 576 (2013)",
          "court": "Supreme Court of New Jersey",
          "year": 2013,
          "date_decided": "2013-02-06",
          "holding": "The Court reversed an abuse-or-neglect finding based on prenatal cocaine use, holding Title 9 requires competent proof of actual harm to the child or of imminent danger or substantial risk of harm.",
          "relevance": "A.L. points to voluntary Title 30 services as the correct response when the statutory harm threshold is not met.",
          "quote": "If an expectant mother's drug use causes actual harm to the physical, mental, or emotional condition of a newborn child, a finding of abuse or neglect is appropriate.",
          "url": "https://www.courtlistener.com/opinion/7409531/new-jersey-department-of-children-families-v-al/",
          "courtlistener_cluster_id": 7409531
        },
        {
          "case_name": "New Jersey Department of Children & Families v. I.S.",
          "citation": "214 N.J. 8, 66 A.3d 1271 (2013)",
          "court": "Supreme Court of New Jersey",
          "year": 2013,
          "date_decided": "2013-06-12",
          "holding": "The Court held that a Title 9 action must be dismissed when no abuse or neglect is proved, but that jurisdiction may continue where the Division also proceeds under Title 30 to secure needed services for the child.",
          "relevance": "I.S. authorizes a services-only path that avoids a Title 9 finding while still protecting the child.",
          "quote": "when the Division brings its complaint also under the authority granted to it under Title 30, the court's jurisdiction may continue",
          "url": "https://www.courtlistener.com/opinion/7409667/new-jersey-department-of-children-families-v-is/",
          "courtlistener_cluster_id": 7409667
        },
        {
          "case_name": "New Jersey Division of Youth & Family Services v. V.T.",
          "citation": "423 N.J. Super. 320, 32 A.3d 578 (App. Div. 2011)",
          "court": "New Jersey Superior Court, Appellate Division",
          "year": 2011,
          "date_decided": "2011-12-21",
          "holding": "The court reversed a neglect finding based on a father's positive cocaine and marijuana tests at two supervised visits, holding that drug use without expert proof of impairment or of actual or imminent harm to the child does not establish neglect.",
          "relevance": "V.T. holds that relapse during treatment calls for continued services rather than a Title 9 finding, since imperfect recovery does not equate to abuse or neglect.",
          "quote": "Contrary to the trial judge's conclusion, use of illegal drugs days prior to a supervised visit does not as a matter of law constitute neglect.",
          "url": "https://www.courtlistener.com/opinion/2318193/div-of-youth-fam-svcs-v-vt/",
          "courtlistener_cluster_id": 2318193
        }
