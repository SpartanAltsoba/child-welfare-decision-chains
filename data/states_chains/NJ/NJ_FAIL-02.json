        {
          "case_name": "Croft v. Westmoreland County Children and Youth Services",
          "citation": "103 F.3d 1123 (3d Cir. 1997)",
          "court": "United States Court of Appeals for the Third Circuit",
          "year": 1997,
          "date_decided": "1997-01-06",
          "holding": "The court reversed summary judgment for the caseworker, holding that forcing a father from his home on the basis of an uncorroborated anonymous tip violated the family's constitutional right to integrity because there were no objectively reasonable grounds to suspect abuse.",
          "relevance": "Croft is the Third Circuit's controlling authority that separating a family without objectively reasonable grounds is actionable under § 1983.",
          "quote": "Even considered together, minor inconsistencies which provide no affirmative evidence of sexual abuse cannot alone establish the objectively reasonable grounds necessary to remove a family member from the family unit.",
          "url": "https://www.courtlistener.com/opinion/732428/croft-v-westmoreland-county-children-and-youth-services/",
          "courtlistener_cluster_id": 732428
        },
        {
          "case_name": "Mammaro v. New Jersey Division of Child Protection & Permanency",
          "citation": "814 F.3d 164 (3d Cir. 2016)",
          "court": "United States Court of Appeals for the Third Circuit",
          "year": 2016,
          "date_decided": "2016-02-19",
          "holding": "The court reversed the denial of qualified immunity to New Jersey caseworkers, holding no clearly established law made the temporary removal of a child on these allegations a substantive due process violation.",
          "relevance": "Mammaro is the Third Circuit's New Jersey-specific qualified-immunity decision limiting damages claims for temporary removals.",
          "quote": "Accordingly, no Supreme Court precedent clearly establishes that D.M.'s temporary removal from her mother's custody violated substantive due process.",
          "url": "https://www.courtlistener.com/opinion/8442576/mammaro-v-new-jersey-division-of-child-protection-permanency/",
          "courtlistener_cluster_id": 8442576
        },
        {
          "case_name": "Stanley v. Illinois",
          "citation": "405 U.S. 645 (1972)",
          "court": "Supreme Court of the United States",
          "year": 1972,
          "date_decided": "1972-04-03",
          "holding": "The Court reversed the dependency adjudication, holding that an unwed father was entitled under the Due Process and Equal Protection Clauses to a hearing on his fitness before the State could take his children from him.",
          "relevance": "Stanley is the foundational federal holding that removing a child from a parent without a fitness hearing violates due process, the premise on which § 1983 unlawful-removal claims rest.",
          "quote": "We have concluded that all Illinois parents are constitutionally entitled to a hearing on their fitness before their children are removed from their custody.",
          "url": "https://www.courtlistener.com/opinion/108497/stanley-v-illinois/",
          "courtlistener_cluster_id": 108497
        }
