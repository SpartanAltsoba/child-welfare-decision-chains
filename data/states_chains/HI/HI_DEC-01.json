    "case_law": {
      "jurisdiction": "Hawaii state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Kaho'ohanohano ex rel. Morales-Kaho'ohanohano v. Department of Human Services",
          "citation": "117 Haw. 262, 178 P.3d 538 (2008)",
          "court": "Supreme Court of Hawai'i",
          "year": 2008,
          "date_decided": "2008-03-20",
          "holding": "The court affirmed a negligence judgment against DHS, holding that once DHS receives a report of suspected child abuse, HRS chapter 587 and its implementing rules create a special relationship and an affirmative legal duty to investigate reasonably and to protect the reported child from further harm.",
          "relevance": "Screening out or minimally reviewing a report does not discharge DHS's duty; an unreasonable investigation after a report is actionable negligence.",
          "quote": "Accordingly, we conclude that DHS had a duty to protect Minor under the circumstances of this case.",
          "url": "https://www.courtlistener.com/opinion/6615449/kahoohanohano-ex-rel-morales-kahoohanohano-v-department-of-human/",
          "courtlistener_cluster_id": 6615449
        },
        {
          "case_name": "In the Interest of Doe",
          "citation": "91 Haw. 166, 981 P.2d 723 (Haw. Ct. App. 1999)",
          "court": "Intermediate Court of Appeals of Hawai'i",
          "year": 1999,
          "date_decided": "1999-07-14",
          "holding": "The ICA affirmed an order of family supervision, holding that a chapter 587 petition is verified by a declaration under penalty of perjury, that threatened harm alone suffices to sustain the petition, and that DHS's disclosure of case information to the police was not a ground for dismissal absent particularized objection.",
          "relevance": "Screening a report out for lack of actual injury misapplies the standard, since threatened harm suffices.",
          "quote": "Thus, allegations of actual harm are not required to sustain a petition for family supervision and allegations of threatened harm would suffice.",
          "url": "https://www.courtlistener.com/opinion/1160891/in-the-interest-of-doe/",
          "courtlistener_cluster_id": 1160891
        },
        {
          "case_name": "DeShaney v. Winnebago County Department of Social Services",
          "citation": "489 U.S. 189 (1989)",
          "court": "Supreme Court of the United States",
          "year": 1989,
          "date_decided": "1989-02-22",
          "holding": "The Court held that the Due Process Clause imposes no general affirmative federal duty on a State to protect a child from private violence, even where caseworkers received and recorded repeated reports of abuse, while noting that States may impose such duties through their own tort law.",
          "relevance": "A screen-out decision is generally not actionable under federal due process, though it may be under Hawai'i negligence law.",
          "quote": "As a general matter, then, we conclude that a State's failure to protect an individual against private violence simply does not constitute a violation of the Due Process Clause.",
          "url": "https://www.courtlistener.com/opinion/112202/deshaney-v-winnebago-county-department-of-social-services/",
          "courtlistener_cluster_id": 112202
        }
      ],
