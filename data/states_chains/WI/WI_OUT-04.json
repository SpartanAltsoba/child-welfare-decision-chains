    "case_law": {
      "jurisdiction": "Wisconsin state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "Green County DHS v. H.N.",
          "citation": "162 Wis. 2d 635, 469 N.W.2d 845 (1991)",
          "court": "Wisconsin Supreme Court",
          "year": 1991,
          "date_decided": "1991-06-07",
          "holding": "A juvenile court loses competency to act when a CHIPS dispositional order expires without a timely extension hearing beyond the single 30-day continuance, and no party can waive that loss of competency.",
          "relevance": "It governs the expiration and extension of the dispositional orders that keep a youth in out-of-home care.",
          "quote": "we hold that a party cannot waive the right to object to a court's loss of competence once the 30-day extension has passed without a hearing",
          "url": "https://www.courtlistener.com/opinion/8237582/green-county-department-of-human-services-v-hn/",
          "courtlistener_cluster_id": 8237582
        },
        {
          "case_name": "W.A.B. v. W.G.B.",
          "citation": "2019 WI App 5, 385 Wis. 2d 514, 925 N.W.2d 783",
          "court": "Court of Appeals of Wisconsin",
          "year": 2018,
          "date_decided": "2018-12-05",
          "holding": "A prior JIPS disposition as to the children does not preclude the county from obtaining a CHIPS disposition against the parents on the same facts; JIPS and CHIPS are distinct proceedings with different parties and purposes.",
          "relevance": "It distinguishes the juvenile-justice and child-welfare tracks that determine which orders continue as a youth ages.",
          "quote": "a JIPS disposition and a CHIPS disposition are two distinct areas of law, and a disposition in the JIPS case did not preclude a disposition in the CHIPS cases",
          "url": "https://www.courtlistener.com/opinion/8287224/wab-v-wgb-in-re-wab/",
          "courtlistener_cluster_id": 8287224
        },
        {
          "case_name": "T.H. v. La Crosse County",
          "citation": "147 Wis. 2d 22, 433 N.W.2d 16 (Ct. App. 1988)",
          "court": "Court of Appeals of Wisconsin",
          "year": 1988,
          "date_decided": "1988-09-29",
          "holding": "The 30-day time limits in Wis. Stat. secs. 48.30(6) and 48.31(7) are mandatory; failure to meet them deprives the juvenile court of competency to hear the petition, requiring the dispositional orders to be vacated and the petitions dismissed.",
          "relevance": "Continued juvenile-court authority over a youth depends on meeting these mandatory deadlines.",
          "quote": "We conclude that the thirty-day time limit in each section is mandatory.",
          "url": "https://www.courtlistener.com/opinion/8237392/th-v-la-crosse-county/",
          "courtlistener_cluster_id": 8237392
        }
      ],
