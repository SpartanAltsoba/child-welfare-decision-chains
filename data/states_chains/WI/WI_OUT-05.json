    "case_law": {
      "jurisdiction": "Wisconsin state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "Sheboygan County DHHS v. Julie A.B.",
          "citation": "2002 WI 95, 255 Wis. 2d 170, 648 N.W.2d 402",
          "court": "Wisconsin Supreme Court",
          "year": 2002,
          "date_decided": "2002-07-10",
          "holding": "At the dispositional phase of a TPR the circuit court must treat the child's best interests as the prevailing factor, weighing the six Wis. Stat. sec. 48.426(3) factors and any others against that standard; applying a different standard (such as requiring 'egregious' unfitness) is an error of law.",
          "relevance": "It holds that a court may dismiss a TPR petition at disposition only if dismissal can be reconciled with the child's best interests, framing lawful case closure.",
          "quote": "The best interests of the child is the polestar for the court in a dispositional hearing, and a failure to apply that standard is an error of law.",
          "url": "https://www.courtlistener.com/opinion/1685479/sheboygan-county-department-of-health-human-services-v-julie-ab/",
          "courtlistener_cluster_id": 1685479
        },
        {
          "case_name": "B.L.J. v. Polk County DSS",
          "citation": "163 Wis. 2d 90, 470 N.W.2d 914 (1991)",
          "court": "Wisconsin Supreme Court",
          "year": 1991,
          "date_decided": "1991-06-25",
          "holding": "Wis. Stat. sec. 48.424(4), which requires a finding of unfitness once statutory grounds are proved, comports with substantive due process because the court retains discretion at disposition to dismiss the petition if termination is not warranted.",
          "relevance": "It preserves the circuit court's power to dismiss a termination petition outright at disposition.",
          "quote": "The discretion that the statute vests in the court to dismiss the petition for termination if it finds termination is not warranted under the standards assures full, substantive due process.",
          "url": "https://www.courtlistener.com/opinion/8237589/blj-v-polk-county-department-of-social-services/",
          "courtlistener_cluster_id": 8237589
        },
        {
          "case_name": "Green County DHS v. H.N.",
          "citation": "162 Wis. 2d 635, 469 N.W.2d 845 (1991)",
          "court": "Wisconsin Supreme Court",
          "year": 1991,
          "date_decided": "1991-06-07",
          "holding": "A juvenile court loses competency to act when a CHIPS dispositional order expires without a timely extension hearing beyond the single 30-day continuance, and no party can waive that loss of competency.",
          "relevance": "Loss of competency is a mandatory, non-waivable basis for ending a CHIPS case.",
          "quote": "we hold that a party cannot waive the right to object to a court's loss of competence once the 30-day extension has passed without a hearing",
          "url": "https://www.courtlistener.com/opinion/8237582/green-county-department-of-human-services-v-hn/",
          "courtlistener_cluster_id": 8237582
        },
        {
          "case_name": "T.H. v. La Crosse County",
          "citation": "147 Wis. 2d 22, 433 N.W.2d 16 (Ct. App. 1988)",
          "court": "Court of Appeals of Wisconsin",
          "year": 1988,
          "date_decided": "1988-09-29",
          "holding": "The 30-day time limits in Wis. Stat. secs. 48.30(6) and 48.31(7) are mandatory; failure to meet them deprives the juvenile court of competency to hear the petition, requiring the dispositional orders to be vacated and the petitions dismissed.",
          "relevance": "Missing the statutory deadlines compels dismissal of the petition.",
          "quote": "We conclude that the thirty-day time limit in each section is mandatory.",
          "url": "https://www.courtlistener.com/opinion/8237392/th-v-la-crosse-county/",
          "courtlistener_cluster_id": 8237392
        }
      ],
