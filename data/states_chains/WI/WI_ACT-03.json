    "case_law": {
      "jurisdiction": "Wisconsin state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "Kara B. v. Dane County",
          "citation": "205 Wis. 2d 140, 555 N.W.2d 630 (1996)",
          "court": "Wisconsin Supreme Court",
          "year": 1996,
          "date_decided": "1996-11-25",
          "holding": "Foster children have a clearly established Fourteenth Amendment right to safe and secure placement; the conduct of the officials who place and supervise them is measured by the professional judgment standard, and those officials were not entitled to qualified immunity.",
          "relevance": "It is the Wisconsin Supreme Court's statement of the constitutional duty owed to a child the state places in foster care.",
          "quote": "Accordingly, we conclude that the duty of public officials to provide foster children with a safe and secure placement is based on a professional judgment standard.",
          "url": "https://www.courtlistener.com/opinion/1721756/kara-b-v-dane-county/",
          "courtlistener_cluster_id": 1721756
        },
        {
          "case_name": "Jones v. Dane County",
          "citation": "195 Wis. 2d 892, 537 N.W.2d 74 (Ct. App. 1995)",
          "court": "Court of Appeals of Wisconsin",
          "year": 1995,
          "date_decided": "1995-07-20",
          "holding": "A caseworker's change of a child's placement without the notice required by Wis. Stat. sec. 48.357(1) was random and unauthorized conduct for which adequate state postdeprivation remedies exist, defeating a federal procedural due process claim; no special relationship created a substantive due process duty.",
          "relevance": "It addresses the notice owed before a county changes a child's placement and the remedy when notice is skipped.",
          "quote": "the trial court properly dismissed the procedural due process claim because Chorlton's actions were random and unauthorized, and adequate postdeprivation state law remedies exist",
          "url": "https://www.courtlistener.com/opinion/1281091/jones-v-dane-county/",
          "courtlistener_cluster_id": 1281091
        },
        {
          "case_name": "Xiong v. Wagner",
          "citation": "700 F.3d 282 (7th Cir. 2012)",
          "court": "United States Court of Appeals for the Seventh Circuit",
          "year": 2012,
          "date_decided": "2012-10-19",
          "holding": "A Racine County caseworker who removed a child on neglect allegations was entitled to qualified immunity because a reasonable caseworker could have believed probable cause existed, and no evidence showed that probable cause dissipated before the court's probable-cause order two days later.",
          "relevance": "Continued foster placement must remain supported by probable cause or it becomes an ongoing seizure.",
          "quote": "However, the continued withholding of a minor may constitute a constitutional violation where probable cause or reasonable suspicion dissipates.",
          "url": "https://www.courtlistener.com/opinion/810539/lia-xiong-v-michael-wagner/",
          "courtlistener_cluster_id": 810539
        },
        {
          "case_name": "K.H. ex rel. Murphy v. Morgan",
          "citation": "914 F.2d 846 (7th Cir. 1990)",
          "court": "United States Court of Appeals for the Seventh Circuit",
          "year": 1990,
          "date_decided": "1990-09-24",
          "holding": "Once the state removes a child and assumes custody, officials may not deliberately and without justification place the child with caregivers known to be likely to abuse or neglect her; doing so violates substantive due process.",
          "relevance": "It is the circuit-level source of the constitutional duty owed to a child the state places in foster care.",
          "quote": "Once the state assumes custody of a person, it owes him a rudimentary duty of safekeeping no matter how perilous his circumstances when he was free.",
          "url": "https://www.courtlistener.com/opinion/548401/murphy-v-morgan/",
          "courtlistener_cluster_id": 548401
        }
      ],
