        {
          "case_name": "Hatch v. Department for Children, Youth & Their Families",
          "citation": "274 F.3d 12 (1st Cir. 2001)",
          "court": "United States Court of Appeals for the First Circuit",
          "year": 2001,
          "date_decided": "2001-12-17",
          "holding": "The First Circuit held that the Constitution allows a caseworker to take temporary custody of a child without a hearing on an objectively reasonable suspicion that abuse has occurred or is imminent, and affirmed because the information the caseworker had, including a school report and a physician's hold, met that standard.",
          "relevance": "This is the governing First Circuit standard for the emergency-removal decision that binds Maine caseworkers.",
          "quote": "Because the welfare of the child is paramount, an objectively reasonable suspicion of abuse justifies protective measures.",
          "url": "https://www.courtlistener.com/opinion/775863/hatch-v-department-for-children-youth-their-families/",
          "courtlistener_cluster_id": 775863
        },
        {
          "case_name": "Tower v. Leslie-Brown",
          "citation": "326 F.3d 290 (1st Cir. 2003)",
          "court": "United States Court of Appeals for the First Circuit",
          "year": 2003,
          "date_decided": "2003-04-22",
          "holding": "The First Circuit affirmed judgment for a Maine Department of Human Services caseworker and a Maine state trooper, holding that removing five children without a prior hearing violated neither substantive nor procedural due process where there was reasonable suspicion of abuse and ex parte judicial review within hours plus a hearing three business days later.",
          "relevance": "This is the controlling circuit authority for a Maine emergency removal: reasonable suspicion of abuse or imminent abuse, followed by prompt ex parte review and a hearing within days.",
          "quote": "no substantive due process violation is stated if there existed a reasonable suspicion that abuse had occurred or that a threat of abuse was imminent at the time of removal",
          "url": "https://www.courtlistener.com/opinion/200436/tower-v-leslie-brown/",
          "courtlistener_cluster_id": 200436
        }
      ],
