    "case_law": {
      "jurisdiction": "Maine state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "In re Thomas D.",
          "citation": "2004 ME 104, 854 A.2d 195",
          "court": "Supreme Judicial Court of Maine",
          "year": 2004,
          "date_decided": "2004-08-04",
          "holding": "The Law Court vacated termination of the father's parental rights because, without a rehabilitation and reunification plan establishing the services he was required to complete, his failure to abstain from alcohol and complete counseling could not establish unfitness by clear and convincing evidence, and vacated as to the mother so her unfitness and best-interest determinations could be reconsidered.",
          "relevance": "The Court describes the plan as the instrument through which services are agreed and measured, so a purely voluntary service arrangement that is never memorialized in a plan cannot later be used as a benchmark against the parent.",
          "quote": "Unless the Department has been excused from reunification efforts, the rehabilitation and reunification plan is the centerpiece of child protective proceedings following a jeopardy determination.",
          "url": "https://www.courtlistener.com/opinion/2326676/in-re-thomas-d/",
          "courtlistener_cluster_id": 2326676
        },
        {
          "case_name": "Adoption of Riahleigh M.",
          "citation": "2019 ME 24, 202 A.3d 1174",
          "court": "Supreme Judicial Court of Maine",
          "year": 2019,
          "date_decided": "2019-02-14",
          "holding": "The Law Court affirmed terminations entered in private adoption proceedings, holding that neither due process nor equal protection requires a court in a title 18-A private termination and adoption case to order the rehabilitation and reunification services that would be available in a title 22 Department case.",
          "relevance": "Voluntary or agency-funded services are a statutory benefit tied to Department involvement, not a constitutional entitlement a parent can demand in a private case.",
          "quote": "In summary, the court was not constitutionally required by the Due Process Clause to order the provision of any particular services in the private adoption proceeding.",
          "url": "https://www.courtlistener.com/opinion/4590683/adoption-of-riahleigh-m/",
          "courtlistener_cluster_id": 4590683
        }
      ],
      "courtlistener_search_url": "https://www.courtlistener.com/?q=%22Maine%22%20AND%20%28%22Maine%20Department%20of%20Health%20and%20Human%20Services%22%20OR%20%22CPS%22%20OR%20%22due%20process%22%20OR%20%2214th%20Amendment%22%20OR%20%2242%20U.S.C.%201983%22%29&type=o&order_by=score+desc",
