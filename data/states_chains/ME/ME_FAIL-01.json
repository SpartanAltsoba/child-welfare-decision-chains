      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Kane v. Commissioner of Department of Health & Human Services",
          "citation": "2008 ME 185, 960 A.2d 1196",
          "court": "Supreme Judicial Court of Maine",
          "year": 2008,
          "date_decided": "2008-12-11",
          "holding": "The Law Court vacated the Commissioner's substantiation of a foster parent for abuse and neglect, holding that because a substantiation carries life-altering consequences and implicates a fundamental liberty interest, it requires proof of something more than imperfect or deficient parenting.",
          "relevance": "It is the paradigm Maine case of a court vacating an agency abuse finding for failure to meet the substantive standard.",
          "quote": "a substantiation finding must be based on an understanding that \"abuse or neglect\" means, for purposes of section 4088(3)(K), something more than imperfect, overly rigid, or even deficient parenting",
          "url": "https://www.courtlistener.com/opinion/5143843/kane-v-commissioner-of-department-of-health-human-services/",
          "courtlistener_cluster_id": 5143843
        },
        {
          "case_name": "In re Child of Barni A.",
          "citation": "2024 ME 16",
          "court": "Supreme Judicial Court of Maine",
          "year": 2024,
          "date_decided": "2024-01-31",
          "holding": "The Law Court vacated termination of a mother's rights to her medically fragile child and remanded, holding that where the Department never provided the 24/7 private duty nursing to which the child was legally entitled under MaineCare and never followed up on indications that the mother has an intellectual disability, the record did not establish her unfitness by clear and convincing evidence.",
          "relevance": "This is the most significant recent Maine reversal of a termination judgment for agency failure, remanded with directions to explore alternatives to termination.",
          "quote": "We cannot assume that the mother would have been found unfit if the Department had met its legal obligations.",
          "url": "https://www.courtlistener.com/opinion/9471586/in-re-child-of-barni-a/",
          "courtlistener_cluster_id": 9471586
        },
        {
          "case_name": "John Doe v. Department of Health and Human Services",
          "citation": "2018 ME 164, 198 A.3d 782",
          "court": "Supreme Judicial Court of Maine",
          "year": 2018,
          "date_decided": "2018-12-18",
          "holding": "The Law Court held that the Department's unpromulgated 2000 policy created no judicially enforceable appeal deadline and that denying Doe any hearing to contest his 2003 substantiation violated procedural due process, and it remanded for the Department to provide him an administrative review and hearing.",
          "relevance": "It is the clearest modern example of a Maine court reversing an agency's refusal to review its own child-abuse finding.",
          "quote": "Thus, all three Mathews factors, as applied to this case, weigh in favor of Doe and against the Department.",
          "url": "https://www.courtlistener.com/opinion/4574269/john-doe-v-department-of-health-and-human-services/",
          "courtlistener_cluster_id": 4574269
        }
      ],
