      "verified_date": "2026-09-21",
      "key_cases": [
        {
          "case_name": "In re Child of Rebecca R.",
          "citation": "2019 ME 165",
          "court": "Supreme Judicial Court of Maine",
          "year": 2019,
          "date_decided": "2019-12-12",
          "holding": "The Law Court affirmed termination of both parents' rights, holding the father's ADA and Maine Human Rights Act accommodation claim was unpreserved because he never requested an accommodation and, in any event, the record supported the finding that his sleep pattern was a lifestyle choice rather than a disability, and that the mother's unfitness rested on far more than her inability to afford housing.",
          "relevance": "This is the Maine authority on disability-discrimination and poverty-based challenges in termination proceedings, and it holds that an accommodation must be requested in the trial court to be reviewable.",
          "quote": "he did not request an accommodation under the ADA or MHRA and thus failed to preserve the issue for appeal",
          "url": "https://www.courtlistener.com/opinion/4686364/in-re-child-of-rebecca-r/",
          "courtlistener_cluster_id": 4686364
        },
        {
          "case_name": "In re Child of Barni A.",
          "citation": "2024 ME 16",
          "court": "Supreme Judicial Court of Maine",
          "year": 2024,
          "date_decided": "2024-01-31",
          "holding": "The Law Court vacated termination of a mother's rights to her medically fragile child and remanded, holding that where the Department never provided the 24/7 private duty nursing to which the child was legally entitled under MaineCare and never followed up on indications that the mother has an intellectual disability, the record did not establish her unfitness by clear and convincing evidence.",
          "relevance": "The Court held that an undiagnosed intellectual disability the Department declined to investigate cannot be the unspoken basis of an unfitness finding.",
          "quote": "We cannot assume that the mother would have been found unfit if the Department had met its legal obligations.",
          "url": "https://www.courtlistener.com/opinion/9471586/in-re-child-of-barni-a/",
          "courtlistener_cluster_id": 9471586
        }
      ],
