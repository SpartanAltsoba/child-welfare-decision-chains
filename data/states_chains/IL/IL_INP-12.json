  "timeline_requirements": [
    {
      "requirement_name": "Initial response time",
      "deadline": "24 hours; immediately, regardless of the time of day or night, if the child's immediate safety or well-being is endangered or the family may flee (325 ILCS 5/7.4(b)(2))",
      "starts_from": "Report received",
      "source": "state_statute",
      "source_url": "https://www.ilga.gov/Legislation/ILCS/Articles?ActID=1460&ChapterID=32",
      "consequence_of_miss": "Not specified in 325 ILCS 5/7.4"
    },
    {
      "requirement_name": "Investigation completion",
      "deadline": "60 days to determine \"indicated\" or \"unfounded\"; extendable in additional periods of up to 30 days for good cause (325 ILCS 5/7.12)",
      "starts_from": "Report received",
      "source": "state_statute",
      "source_url": "https://www.ilga.gov/Legislation/ILCS/Articles?ActID=1460&ChapterID=32",
      "consequence_of_miss": "Report may be deemed \"undetermined\" where a complete investigation was not possible (325 ILCS 5/7.12)"
    },
    {
      "requirement_name": "Temporary custody hearing",
      "deadline": "48 hours, excluding Saturdays, Sundays and court-designated holidays (705 ILCS 405/2-9(1))",
      "starts_from": "Child taken into temporary protective custody",
      "source": "state_statute",
      "source_url": "https://www.ilga.gov/legislation/ILCS/details?ActID=1863&ChapterID=50&ChapAct=705%2BILCS%2B405%2F&SeqStart=2600000&SeqEnd=7600000",
      "consequence_of_miss": "The child must be released from temporary protective custody if not brought before a judicial officer within the 48 hours (705 ILCS 405/2-9(3))"
    }
  ],
