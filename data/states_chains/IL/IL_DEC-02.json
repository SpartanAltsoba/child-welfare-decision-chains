        {
          "case_name": "Michael C. v. Gresbach",
          "citation": "526 F.3d 1008 (7th Cir. 2008)",
          "court": "United States Court of Appeals for the Seventh Circuit",
          "year": 2008,
          "date_decided": "2008-05-19",
          "holding": "The court affirmed denial of qualified immunity, holding that a caseworker's under-the-clothes examination of children at a private school exceeded the principal's consent to interview them and violated their clearly established Fourth Amendment rights.",
          "relevance": "Sets the Fourth Amendment limits on how far an accepted investigation may go without a warrant or valid consent.",
          "quote": "the searches of the children's bodies to investigate child abuse were presumptively unreasonable, unless they fall within an exception to the warrant requirement of the Fourth Amendment",
          "url": "https://www.courtlistener.com/opinion/1190279/michael-c-v-gresbach/",
          "courtlistener_cluster_id": 1190279
        },
        {
          "case_name": "Doe v. Heck",
          "citation": "327 F.3d 492 (7th Cir. 2003)",
          "court": "United States Court of Appeals for the Seventh Circuit",
          "year": 2003,
          "date_decided": "2003-05-15",
          "holding": "The court held that caseworkers who searched a private religious school and seized a student for a child-abuse interview without a warrant, court order, probable cause, consent or exigent circumstances violated the Fourth Amendment and the family's right to familial relations, but affirmed qualified immunity because those rights were not yet clearly established.",
          "relevance": "Sets the constitutional ceiling on an accepted investigation: caseworkers may investigate, but not arbitrarily and not by warrantless entry onto private property.",
          "quote": "although child welfare caseworkers may investigate allegations of child abuse without violating parents' constitutional right to familial relations, they may not do so arbitrarily",
          "url": "https://www.courtlistener.com/opinion/781752/doe-v-heck/",
          "courtlistener_cluster_id": 781752
        }
