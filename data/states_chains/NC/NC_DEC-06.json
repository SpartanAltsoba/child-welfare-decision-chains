        {
          "case_name": "In re Stumbo",
          "citation": "357 N.C. 279, 582 S.E.2d 255 (2003)",
          "court": "Supreme Court of North Carolina",
          "year": 2003,
          "date_decided": "2003-07-16",
          "holding": "The Supreme Court held that a single anonymous report that a two-year-old was seen naked and unsupervised in her own driveway did not describe neglect under N.C.G.S. § 7B-101 and therefore never triggered the mandatory investigation power of § 7B-302, so the § 7B-303 non-interference order against the parents had to be reversed.",
          "relevance": "It endorses a non-coercive, service-oriented response to low-risk reports without invoking Chapter 7B petitions.",
          "quote": "a single report of a naked, unsupervised two-year-old in the driveway of her home does not trigger the investigative requirements of N.C.G.S. § 7B-302",
          "url": "https://www.courtlistener.com/opinion/1285049/in-re-stumbo/",
          "courtlistener_cluster_id": 1285049
        },
        {
          "case_name": "In re W.B.M.",
          "citation": "202 N.C. App. 606, 690 S.E.2d 41 (2010)",
          "court": "Court of Appeals of North Carolina",
          "year": 2010,
          "date_decided": "2010-03-02",
          "holding": "The Court of Appeals held that placement on the Responsible Individuals List deprives a person of liberty interests protected by Article I, Section 19 of the North Carolina Constitution, and that the statutory scheme was unconstitutional because it permitted listing without a pre-deprivation hearing at which the director must prove abuse or serious neglect by a preponderance of the evidence.",
          "relevance": "Choosing a non-court, service-based response avoids the liberty deprivation that triggers these hearing rights.",
          "quote": "we hold that an individual has a right to notice and an opportunity to be heard before being placed on the RIL",
          "url": "https://www.courtlistener.com/opinion/1405237/in-re-wbm/",
          "courtlistener_cluster_id": 1405237
        }
      ],
