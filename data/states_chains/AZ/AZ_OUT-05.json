      "key_cases": [
        {
          "case_name": "Louis C. v. Department of Child Safety",
          "citation": "237 Ariz. 484, 353 P.3d 364 (App. 2015)",
          "court": "Court of Appeals of Arizona",
          "year": 2015,
          "date_decided": "2015-06-24",
          "holding": "The court of appeals affirmed the dependency adjudication, holding that A.R.S. § 8-844(C) requires the juvenile court to adjudicate dependency on a preponderance of the evidence and that the Parents' Bill of Rights does not raise that burden.",
          "relevance": "A case must be dismissed where the agency cannot carry even the preponderance burden.",
          "quote": "Section 8-844(C) not only permits a court to enter an order of dependency based on a preponderance of the evidence, but directs that a court \"shall\" do so.",
          "url": "https://www.courtlistener.com/opinion/2811466/louis-c-v-department-of-child-safety/",
          "courtlistener_cluster_id": 2811466
        },
        {
          "case_name": "Titus S. v. Department of Child Safety",
          "citation": "418 P.3d 1138 (Ariz. Ct. App. 2018)",
          "court": "Court of Appeals of Arizona",
          "year": 2018,
          "date_decided": "2018-04-09",
          "holding": "The court of appeals reversed the order terminating an out-of-state father's rights, holding the best-interests finding was an abuse of discretion where the current caregivers would not consent to adoption and no evidence suggested adoption was otherwise likely.",
          "relevance": "Supports refusing or dismissing a termination petition where severance would leave the child in legal limbo.",
          "quote": "In these circumstances, where there is no evidentiary basis to suggest adoption is likely, we conclude the severe and permanent consequence of termination is unwarranted.",
          "url": "https://www.courtlistener.com/opinion/6656605/titus-s-v-dept-of-child-safety/",
          "courtlistener_cluster_id": 6656605
        },
        {
          "case_name": "Brionna J. v. Department of Child Safety",
          "citation": "255 Ariz. 471 (2023)",
          "court": "Arizona Supreme Court",
          "year": 2023,
          "date_decided": "2023-08-08",
          "holding": "The Arizona Supreme Court vacated the court of appeals' opinion and affirmed the termination order, holding that the intermediate court misapplied the fifteen-months-in-care ground, reweighed the evidence, used the wrong standard of review, and could not dismiss the dependency in an appeal from the termination order.",
          "relevance": "Confirms that a dependency finding cannot be collaterally dismissed through an appeal of the later termination order.",
          "quote": "The court of appeals also erred when it exceeded the proper scope of review by reweighing the evidence presented to the juvenile court.",
          "url": "https://www.courtlistener.com/opinion/9418726/brionna-j-v-dcsav/",
          "courtlistener_cluster_id": 9418726
        }
