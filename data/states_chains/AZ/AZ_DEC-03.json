    "case_law": {
      "jurisdiction": "Arizona state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In Re the Appeal in Cochise County Juvenile Action No. 5666-J",
          "citation": "133 Ariz. 157, 650 P.2d 459 (1982)",
          "court": "Arizona Supreme Court",
          "year": 1982,
          "date_decided": "1982-07-29",
          "holding": "The Arizona Supreme Court vacated the court of appeals' opinion and affirmed the juvenile court's dismissal of the dependency petition, holding that Santosky's clear-and-convincing standard is confined to termination and that dependency must be proved only by a preponderance of the evidence, which the State had not done.",
          "relevance": "Marks the constitutional line Santosky draws — a finding short of termination does not carry the clear-and-convincing burden, but the State must still prove abuse or neglect in court.",
          "quote": "the weighing of the private and public interests convinces us that the preponderance of the evidence standard is the proper standard of proof in dependency proceedings",
          "url": "https://www.courtlistener.com/opinion/1357609/in-re-the-appeal-in-cochise-county-juvenile-action-no-5666-j/",
          "courtlistener_cluster_id": 1357609
        },
        {
          "case_name": "Santosky v. Kramer",
          "citation": "455 U.S. 745 (1982)",
          "court": "Supreme Court of the United States",
          "year": 1982,
          "date_decided": "1982-02-22",
          "holding": "The Supreme Court reversed and remanded, holding that due process requires a State to support its allegations by at least clear and convincing evidence before terminating parental rights, while leaving any higher standard to state law.",
          "relevance": "Supplies the federal due process floor that constrains how a state's abuse or neglect findings may be used to sever a family.",
          "quote": "We hold that such a standard adequately conveys to the factfinder the level of subjective certainty about his factual conclusions necessary to satisfy due process.",
          "url": "https://www.courtlistener.com/opinion/110676/santosky-v-kramer/",
          "courtlistener_cluster_id": 110676
        },
        {
          "case_name": "Louis C. v. Department of Child Safety",
          "citation": "237 Ariz. 484, 353 P.3d 364 (App. 2015)",
          "court": "Court of Appeals of Arizona",
          "year": 2015,
          "date_decided": "2015-06-24",
          "holding": "The court of appeals affirmed the dependency adjudication, holding that A.R.S. § 8-844(C) requires the juvenile court to adjudicate dependency on a preponderance of the evidence and that the Parents' Bill of Rights does not raise that burden.",
          "relevance": "Confirms that an agency finding of abuse or neglect must be independently proved to the court by a preponderance.",
          "quote": "Section 8-844(C) not only permits a court to enter an order of dependency based on a preponderance of the evidence, but directs that a court \"shall\" do so.",
          "url": "https://www.courtlistener.com/opinion/2811466/louis-c-v-department-of-child-safety/",
          "courtlistener_cluster_id": 2811466
        },
        {
          "case_name": "Oscar F. v. Department of Child Safety",
          "citation": "235 Ariz. 266, 330 P.3d 1023 (App. 2014)",
          "court": "Court of Appeals of Arizona",
          "year": 2014,
          "date_decided": "2014-07-30",
          "holding": "The court of appeals affirmed the dependency adjudication, holding the juvenile court had statutory authority to find the children dependent as to one parent notwithstanding the petition's allegations or the failure to serve the other parent or guardian.",
          "relevance": "Shows that a dependency finding may rest on the statutory definitions of neglect and unfitness rather than on the petition's precise framing.",
          "quote": "The juvenile court was authorized by statute to adjudicate the children dependent as to Oscar, notwithstanding allegations in the petition or that another parent or guardian has not been served.",
          "url": "https://www.courtlistener.com/opinion/2689001/oscar-f-v-dcs-ef-mf-c-f-gf-and-lf/",
          "courtlistener_cluster_id": 2689001
        }
      ],
