      "key_cases": [
        {
          "case_name": "Mary Ellen C. v. Arizona Department of Economic Security",
          "citation": "193 Ariz. 185, 971 P.2d 1046 (App. 1999)",
          "court": "Court of Appeals of Arizona",
          "year": 1999,
          "date_decided": "1999-01-19",
          "holding": "The court of appeals reversed the severance order because the State failed to make reasonable efforts to preserve the family, holding that the duty to provide rehabilitative services with a reasonable possibility of success has a constitutional basis.",
          "relevance": "Supports resolving a case through meaningful services rather than a petition where services offer a reasonable possibility of success.",
          "quote": "although the State is not obliged to undertake futile rehabilitative measures, it is obliged to undertake those which offer a reasonable possibility of success",
          "url": "https://www.courtlistener.com/opinion/1420233/mary-ellen-c-v-arizona-department-of-economic-security/",
          "courtlistener_cluster_id": 1420233
        },
        {
          "case_name": "Mary Lou C. v. Arizona Department of Economic Security",
          "citation": "207 Ariz. 43, 83 P.3d 43 (App. 2004)",
          "court": "Court of Appeals of Arizona",
          "year": 2004,
          "date_decided": "2004-01-27",
          "holding": "The court of appeals affirmed the severance order, holding that the State's constitutionally grounded obligation to make a reasonable effort to preserve the family applies to the prior-severance ground of A.R.S. § 8-533(B)(10) as it does to other grounds, but affirming because the record supported an implicit finding that further rehabilitative services would have been futile.",
          "relevance": "Confirms the agency's service obligation attaches before any petition-based ground is proven, which is the legal premise of a services-without-petition track.",
          "quote": "The requirement that ADES make an effort to preserve the family is mandated on constitutional grounds",
          "url": "https://www.courtlistener.com/opinion/6603802/mary-lou-c-v-arizona-department-of-economic-security/",
          "courtlistener_cluster_id": 6603802
        },
        {
          "case_name": "Shawanee S. v. Arizona Department of Economic Security",
          "citation": "234 Ariz. 174, 319 P.3d 236 (App. 2014)",
          "court": "Court of Appeals of Arizona",
          "year": 2014,
          "date_decided": "2014-02-25",
          "holding": "The court of appeals affirmed the termination order, holding that although the agency must prove a diligent effort to provide appropriate reunification services on a length-of-time-in-care ground, a parent who never objects in the juvenile court waives an appellate challenge to that finding.",
          "relevance": "Confirms the agency's service obligation exists independently of whether the case proceeds by petition.",
          "quote": "when ADES seeks severance based on length of time in care, ADES must prove that it \"has made a diligent effort to provide appropriate reunification services.\"",
          "url": "https://www.courtlistener.com/opinion/2654875/shawanee-s-v-arizona-department-of-economic-security/",
          "courtlistener_cluster_id": 2654875
        },
        {
          "case_name": "Lorenz v. State",
          "citation": "238 Ariz. 556, 364 P.3d 475 (App. 2015)",
          "court": "Court of Appeals of Arizona",
          "year": 2015,
          "date_decided": "2015-12-08",
          "holding": "The court of appeals affirmed dismissal of grandparents' civil suit against DCS, holding the child-welfare statutes, rules, and policies they invoked create no civil duty running to relatives who seek placement of a dependent child.",
          "relevance": "Confirms agency discretion in front-end case handling is not constrained by a private duty to relatives.",
          "quote": "Because the cited authorities reveal an intent to protect and benefit dependent children, not potential foster or adoptive placements, we affirm the superior court's judgment.",
          "url": "https://www.courtlistener.com/opinion/3160631/lorenz-v-state/",
          "courtlistener_cluster_id": 3160631
        }
      ],
