  "timeline_requirements": [
    {
      "requirement_name": "Safety decision",
      "deadline": "No clock set by rule - initial safety assessment of the child's circumstances and threat of danger or harm, and a safety plan where appropriate, in both family assessments and investigations; the first face-to-face contact with the child is due within the response time set at intake, or within 24 hours when the victim child is younger than two (22VAC40-705-80(A)(1), (B)(1))",
      "starts_from": "The worker's first contact in the family assessment or investigation",
      "source": "admin_rule",
      "source_url": "https://law.lis.virginia.gov/admincode/title22/agency40/chapter705/section110/",
      "consequence_of_miss": "Not specified in 22VAC40-705-110(A)"
    },
    {
      "requirement_name": "Disposition finding",
      "deadline": "45 days (extendable to a total of 60 days on written justification, or to 90 days in a joint law-enforcement investigation)",
      "starts_from": "Investigation opened",
      "source": "state_statute",
      "source_url": "https://law.lis.virginia.gov/vacode/title63.2/chapter15/section63.2-1505/",
      "consequence_of_miss": "Statute sets no penalty; any extension requires written justification and the local department must notify the alleged abuser or neglector and the child's parents (Va. Code § 63.2-1505(B)(5); 22VAC40-705-120)"
    }
  ],
