          "courtlistener_cluster_id": 1696726
        },
        {
          "case_name": "Davis v. Vaughn",
          "citation": "126 So. 3d 33 (Miss. 2013)",
          "court": "Supreme Court of Mississippi",
          "year": 2013,
          "date_decided": "2013-11-21",
          "holding": "The Court affirmed the award of custody to the natural father over the maternal grandmother and declined to change the established grounds for rebutting the natural-parent presumption.",
          "relevance": "A relative caregiver's petition is measured against the parent's presumptive right, which shapes what a guardian's request for help can achieve.",
          "quote": "we find no legally compelling reason to alter or abandon our established standards for rebuttal of the natural-parent presumption",
          "url": "https://www.courtlistener.com/opinion/5105232/davis-v-vaughn/",
          "courtlistener_cluster_id": 5105232
        },
        {
          "case_name": "In the Matter of the Dissolution of the Marriage of Leverock and Hamby: Pendleton v. Leverock",
          "citation": "23 So. 3d 424 (Miss. 2009)",
          "court": "Supreme Court of Mississippi",
          "year": 2009,
          "date_decided": "2009-12-03",
          "holding": "The Court affirmed the chancellor's refusal to terminate the father's parental rights but reversed the award of custody to him, holding the record established desertion so that the natural-parent presumption was rebutted and custody had to be redetermined through an on-the-record Albright best-interests analysis.",
          "relevance": "The third-party caregivers who had raised the child since infancy petitioned in their own right, the private route by which a caregiver's request for authority over a child reaches a court.",
          "quote": "This presumption in favor of a natural parent has long been recognized, and Tony is entitled to it unless there is proof that he has relinquished it.",
          "url": "https://www.courtlistener.com/opinion/1614077/in-re-marriage-of-leverock-hamby/",
          "courtlistener_cluster_id": 1614077
        }
