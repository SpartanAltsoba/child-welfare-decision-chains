        {
          "case_name": "In the Matter of the Guardianship of LNP",
          "citation": "2013 WY 20, 294 P.3d 904",
          "court": "Wyoming Supreme Court",
          "year": 2013,
          "date_decided": "2013-02-20",
          "holding": "In Wyoming's principal Indian Child Welfare Act decision, the Court affirmed a permanent guardianship of an Indian child, holding that a communication giving the court reason to know the child was Indian triggered ICWA § 1912(a) notice, that a qualified expert witness under § 1912(e) need not have expertise in tribal customs, and that clear and convincing evidence supported the serious-damage finding.",
          "relevance": "Sets the Wyoming standard for a permanent guardianship of an Indian child, including the parental-unfitness finding and the guardianship's revocability.",
          "quote": "neither the ICWA, nor the relevant BIA Guidelines, require a “qualified expert witness” to possess expertise in tribal customs",
          "url": "https://www.courtlistener.com/opinion/822659/in-the-matter-of-the-guardianship-of-lnp-a-minor-child-kc-v-cc-and-ec/",
          "courtlistener_cluster_id": 822659
        },
        {
          "case_name": "In the Interest of JW v. State",
          "citation": "2010 WY 28, 226 P.3d 873",
          "court": "Wyoming Supreme Court",
          "year": 2010,
          "date_decided": "2010-03-18",
          "holding": "The Court reversed a permanency order placing children with non-relative foster parents and remanded with instructions to place them with their uncle and aunt, rejecting the argument that the federal and state kinship-placement preferences are merely precatory.",
          "relevance": "Supports kinship permanency as the preferred outcome where suitable relatives have been identified.",
          "quote": "We are unable to accept these characterizations given the high stakes in play here",
          "url": "https://www.courtlistener.com/opinion/2586510/in-the-interest-of-jw-v-state/",
          "courtlistener_cluster_id": 2586510
        }
      ],
