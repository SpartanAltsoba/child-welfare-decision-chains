    "case_law": {
      "jurisdiction": "Montana state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re B.P.",
          "citation": "2000 MT 39, 298 Mont. 287, 995 P.2d 982",
          "court": "Montana Supreme Court",
          "year": 2000,
          "date_decided": "2000-02-15",
          "holding": "An interlocutory order granting temporary investigative authority and protective services is not appealable under Rule 1, M.R.App.P.; review must be sought by certiorari, habeas corpus or supervisory control, although the Court suspended the rules and reached the merits here because the parties had relied on a contrary prior statement.",
          "relevance": "The order at issue was an order for protective services short of termination, which is Montana's nearest analogue to a protective order in a child-protection case.",
          "quote": "We hold, therefore, that an interlocutory order granting temporary investigative authority and protective services is not appealable under Rule 1, M.R.App.P.",
          "url": "https://www.courtlistener.com/opinion/8070481/in-re-bp/",
          "courtlistener_cluster_id": 8070481
        },
        {
          "case_name": "K.D.R.-M. v. R.E.M.",
          "citation": "2004 MT 292, 323 Mont. 340, 100 P.3d 150",
          "court": "Montana Supreme Court",
          "year": 2004,
          "date_decided": "2004-10-21",
          "holding": "Reversed and remanded for a hearing on the merits: the district court manifestly abused its discretion by summarily dismissing a mother's temporary orders of protection, entered to shield her daughter from alleged physical and sexual abuse by the father, without an evidentiary hearing on his motion to vacate and while he remained in violation of twice-ordered sexual-offender and mental-health evaluations.",
          "relevance": "It is the published Montana authority closest to this decision point: an order of protection obtained to prevent an allegedly abusive parent's contact with a child without removing the child, and the evidentiary hearing a court must hold before vacating one, even after CFS closes its investigation as unsubstantiated.",
          "quote": "We hold that dismissal of the mother's case was a manifest abuse of the District Court's discretion under the circumstances of this case",
          "url": "https://www.courtlistener.com/opinion/886761/kdr-m-v-rem/",
          "courtlistener_cluster_id": 886761
        }
      ],
