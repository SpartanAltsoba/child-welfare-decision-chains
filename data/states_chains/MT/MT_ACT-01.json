    "case_law": {
      "jurisdiction": "Montana state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "In re J.C.",
          "citation": "2008 MT 127, 343 Mont. 30, 183 P.3d 22",
          "court": "Montana Supreme Court",
          "year": 2008,
          "date_decided": "2008-04-21",
          "holding": "Termination was affirmed; a youth-in-need-of-care adjudication is not a prerequisite to temporary investigative authority under § 41-3-433 or to a court-ordered treatment plan under § 41-3-443(1) where the parents admit or stipulate to the allegations.",
          "relevance": "It confirms that a treatment plan entered on the parents' admission or stipulation is valid and enforceable even absent an adjudication.",
          "quote": "a YINC adjudication is not always required for TIA and court-approved treatment plans",
          "url": "https://www.courtlistener.com/opinion/8071677/in-re-jc/",
          "courtlistener_cluster_id": 8071677
        },
        {
          "case_name": "In re B.J.J.",
          "citation": "2019 MT 129, 396 Mont. 108, 443 P.3d 488",
          "court": "Montana Supreme Court",
          "year": 2019,
          "date_decided": "2019-06-04",
          "holding": "Termination was affirmed: the Department made the reasonable efforts required by § 41-3-423(1) where it prepared and explained a treatment plan and offered services, even though the father never signed or returned the plan and the court approved it on the Department's motion.",
          "relevance": "It is the Montana case on what happens when a parent agrees to but does not execute a proposed service plan.",
          "quote": "From our review of the record, we conclude the Department provided reasonable efforts as required by § 41-3-423(1), MCA.",
          "url": "https://www.courtlistener.com/opinion/6658899/in-re-bjj/",
          "courtlistener_cluster_id": 6658899
        },
        {
          "case_name": "In re D.B.",
          "citation": "2007 MT 246, 339 Mont. 240, 168 P.3d 691",
          "court": "Montana Supreme Court",
          "year": 2007,
          "date_decided": "2007-09-25",
          "holding": "Termination was reversed and remanded: the district court applied the wrong criteria by resting on 'reasonable efforts to accomplish alternatives' and the 15-of-22-month presumption instead of the two-prong § 41-3-609(1)(f) inquiry, and on remand it must decide whether the treatment plan adequately addressed the cognitively disabled mother's disabilities by setting reasonable deadlines and providing the support the law requires.",
          "relevance": "It holds that the State — not the parent — must prove a service plan is appropriate by clear and convincing evidence and must act in good faith in developing and executing it, a duty that continues after the court approves the plan.",
          "quote": "The State's burden to ensure appropriateness and duty to act in good faith does not end once the court has approved a treatment plan.",
          "url": "https://www.courtlistener.com/opinion/8071529/in-re-db/",
          "courtlistener_cluster_id": 8071529
        }
      ],
