      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Horridge v. St. Mary's County Department of Social Services",
          "citation": "382 Md. 170, 854 A.2d 1232 (2004)",
          "court": "Court of Appeals of Maryland",
          "year": 2004,
          "date_decided": "2004-07-28",
          "holding": "Reversing dismissal of a wrongful-death complaint, the Court held that FL § 5-706 and its regulations create a mandatory duty owed to the identified child named in an abuse report, so the public duty doctrine does not bar a negligence action against the department and its caseworkers.",
          "relevance": "It is Maryland's controlling authority on civil liability for a child's death after agency failure to investigate.",
          "quote": "This is not an obligation that runs to everyone in general and no one in particular. It runs to an identified or identifiable child or discrete group of children.",
          "url": "https://www.courtlistener.com/opinion/2326632/horridge-v-st-marys-county-department-of-social-services/",
          "courtlistener_cluster_id": 2326632
        },
        {
          "case_name": "Wells v. State",
          "citation": "100 Md. App. 693, 642 A.2d 879 (1994)",
          "court": "Court of Special Appeals of Maryland",
          "year": 1994,
          "date_decided": "1994-06-10",
          "holding": "In a suit by an abused child against the State and social workers, the court affirmed dismissal, holding that state personnel retained statutory immunity absent malice or gross negligence, that the tort claim failed for lack of the required notice, and that violation of state-mandated investigative procedures is not itself a federal due process deprivation.",
          "relevance": "It sets out the immunity and notice obstacles a child injured under agency supervision faces in Maryland.",
          "quote": "The violation of State-mandated procedures may well give rise to an action under State law, if the appropriate preconditions to such an action are followed",
          "url": "https://www.courtlistener.com/opinion/2009429/wells-v-state/",
          "courtlistener_cluster_id": 2009429
        },
        {
          "case_name": "DeShaney v. Winnebago County Department of Social Services",
          "citation": "489 U.S. 189 (1989)",
          "court": "Supreme Court of the United States",
          "year": 1989,
          "date_decided": "1989-02-22",
          "holding": "The Court held that a state agency's failure to protect a child from a known risk of parental abuse, where the child remained in his father's custody, did not deprive him of liberty in violation of the Due Process Clause.",
          "relevance": "It forecloses the federal substantive due process theory for a death occurring while the child is in parental custody.",
          "quote": "The Clause is phrased as a limitation on the State's power to act, not as a guarantee of certain minimal levels of safety and security.",
          "url": "https://www.courtlistener.com/opinion/112202/deshaney-v-winnebago-cty-dept-of-social-servs/",
          "courtlistener_cluster_id": 112202
        }
      ],
