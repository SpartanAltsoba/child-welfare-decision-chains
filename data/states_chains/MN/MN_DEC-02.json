  "timeline_requirements": [
    {
      "requirement_name": "Safety decision",
      "deadline": "Safety assessment completed at the face-to-face contact with the child and the child's primary caregiver, which must be sufficient to ensure the immediate safety of the child",
      "starts_from": "Receipt of a screened in report",
      "source": "state_statute",
      "source_url": "https://www.revisor.mn.gov/statutes/cite/260E.20",
      "consequence_of_miss": "Not specified in Minn. Stat. § 260E.20; subd. 2(a) requires the face-to-face contact to be sufficient to complete a safety assessment and ensure the immediate safety of the child."
    },
    {
      "requirement_name": "Disposition finding",
      "deadline": "45 days",
      "starts_from": "Receipt of the report",
      "source": "state_statute",
      "source_url": "https://www.revisor.mn.gov/statutes/cite/260E.24",
      "consequence_of_miss": "Not specified by statute; Minn. Stat. § 260E.24, subd. 3 requires the two determinations at the conclusion of the investigation and subd. 5 requires written notice within ten working days of that conclusion."
    },
    {
      "requirement_name": "Maltreatment determination reconsideration",
      "deadline": "15 calendar days",
      "starts_from": "Receipt of notice of the investigating agency's final determination regarding maltreatment",
      "source": "state_statute",
      "source_url": "https://www.revisor.mn.gov/statutes/cite/260E.33",
      "consequence_of_miss": "Not specified in Minn. Stat. § 260E.33; subd. 2 requires the written request within 15 calendar days after receipt of notice of the final determination, subd. 3 allows a fair hearing only after the agency denies the reconsideration request or fails to act on it within 15 working days, and subd. 1 provides no reconsideration after a family assessment or noncaregiver human trafficking assessment because no maltreatment determination is made."
    }
  ],
