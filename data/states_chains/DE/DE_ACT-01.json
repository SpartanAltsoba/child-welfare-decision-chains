    "case_law": {
      "jurisdiction": "Delaware state courts",
      "method": "v1.1.0 case-law rebuild: authorities selected per decision point, each opinion retrieved from CourtListener and read; holding and quote taken from the opinion text; independently re-verified before release. Previous keyword-matched Justia listings were removed.",
      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Division of Family Services v. James",
          "citation": "28 A.3d 480 (Del. Fam. Ct. 2009)",
          "court": "Delaware Family Court",
          "year": 2009,
          "date_decided": "2009-12-18",
          "holding": "The Family Court denied the Division's motion to be relieved of offering reunification services to a mother whose rights to a sibling had been involuntarily terminated, holding that the decision whether reasonable efforts are required rests with the court rather than the agency, and ordering reunification to remain the permanency goal.",
          "relevance": "Ordered the Division to continue offering the services in the tendered case plan while its motion was pending.",
          "quote": "In either case, judicial authority to keep secure a child's best interest throughout a case can never be interrupted or, even for a brief point in time, delegated elsewhere.",
          "url": "https://www.courtlistener.com/opinion/2324882/division-of-family-services-v-james/",
          "courtlistener_cluster_id": 2324882
        },
        {
          "case_name": "Waters v. Division of Family Services",
          "citation": "903 A.2d 721 (Del. 2006)",
          "court": "Supreme Court of Delaware",
          "year": 2006,
          "date_decided": "2006-07-17",
          "holding": "The Court reversed the termination of the father's parental rights, holding that the State denied him procedural due process by terminating without first providing any meaningful case plan or attempting feasible reunification, and that the abandonment finding was not supported by clear and convincing evidence.",
          "relevance": "Establishes that the offer of a workable plan and services is constitutionally significant, not optional.",
          "quote": "Ashley was entitled to a timely permanency decision, but in these circumstances that entitlement could not trump her father's due process right to a reasonable opportunity for reunification.",
          "url": "https://www.courtlistener.com/opinion/1443975/waters-v-division-of-family-services/",
          "courtlistener_cluster_id": 1443975
        },
        {
          "case_name": "Stewart v. Department of Services for Children, Youth, & Their Families",
          "citation": "991 A.2d 750 (Del. 2010)",
          "court": "Supreme Court of Delaware",
          "year": 2010,
          "date_decided": "2010-03-16",
          "holding": "Affirming termination and the denial of two relatives' guardianship petitions, the Court held that a guardianship petitioner must show by a preponderance both that the child is dependent or neglected and that guardianship is in the child's best interests, and that DFS made appropriate reunification services available to a mother with mental disabilities.",
          "relevance": "Measures the adequacy of voluntary and agency-arranged services against the parent's documented limitations.",
          "quote": "To grant a guardianship petition, two factors must be shown by the preponderance of the evidence",
          "url": "https://www.courtlistener.com/opinion/2273628/stewart-v-department-of-services-for-children-youth-their-families/",
          "courtlistener_cluster_id": 2273628
        },
        {
          "case_name": "In re Burns",
          "citation": "519 A.2d 638 (Del. 1986)",
          "court": "Supreme Court of Delaware",
          "year": 1986,
          "date_decided": "1986-12-19",
          "holding": "The Court reversed the termination of a young mother's parental rights and returned custody of her son to her, holding that requiring an unrepresented minor to sign a voluntary placement agreement as the price of housing assistance, followed by an ex parte custody order entered without the notice the rules required, fell below minimum due process, and that the agencies' failure to provide meaningful case plans or make reasonable efforts to prevent removal and reunify the family independently vitiated the judgment.",
          "relevance": "Holds that a nominally voluntary placement agreement extracted from an unrepresented minor, as a Hobson's choice against losing her child, cannot satisfy due process.",
          "quote": "DCPS must prove by clear and convincing evidence that termination of parental rights is essential to the child's welfare.",
          "url": "https://www.courtlistener.com/opinion/1516637/matter-of-burns/",
          "courtlistener_cluster_id": 1516637
        }
      ],
