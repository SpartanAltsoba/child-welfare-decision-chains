      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Division of Family Services v. Redman",
          "citation": "979 A.2d 1138 (Del. Fam. Ct. 2009)",
          "court": "Delaware Family Court",
          "year": 2009,
          "date_decided": "2009-04-15",
          "holding": "The Family Court granted the Division's motion to quash a parent's Rule 45 subpoena duces tecum for the Division's case file, holding that a trial subpoena is not the proper vehicle and that access must instead proceed through an expedited discovery request consistent with the Division's federal and state confidentiality obligations.",
          "relevance": "The Delaware authority on when the Division may and may not withhold its records, and the procedure a party must use to compel them.",
          "quote": "For the reasons that will follow, the Court is granting the Division's Motion to Quash the subpoena which was issued pursuant to Family Court Civil Rule 45.",
          "url": "https://www.courtlistener.com/opinion/1536786/division-of-family-services-v-redman/",
          "courtlistener_cluster_id": 1536786
        },
        {
          "case_name": "Division of Family Services v. A.B.",
          "citation": "980 A.2d 1045 (Del. Fam. Ct. 2009)",
          "court": "Delaware Family Court",
          "year": 2009,
          "date_decided": "2009-06-25",
          "holding": "The Family Court held a substance-abuse treatment provider in civil contempt and fined it for failing to produce a mother's records in response to the court's good-cause disclosure order and subpoena duces tecum, notwithstanding the federal confidentiality rules governing such records.",
          "relevance": "Shows the sanction available when an entity fails to disclose records a court has ordered produced.",
          "quote": "Furthermore, in a civil contempt proceeding, it is not a defense that the party in contempt did not have subjective intent to violate the Court's Order.",
          "url": "https://www.courtlistener.com/opinion/2306069/division-of-family-services-v-ab/",
          "courtlistener_cluster_id": 2306069
        },
        {
          "case_name": "Flowers, Jr. v. Office of the Governor",
          "citation": "167 A.3d 530 (Del. Super. Ct. 2017)",
          "court": "Superior Court of Delaware",
          "year": 2017,
          "date_decided": "2017-08-08",
          "holding": "On appeal from the Chief Deputy Attorney General's FOIA determination, the Superior Court held that the burden of proof rests on the public body to give sufficient reasons for withholding records and found that the Governor's Office satisfied that burden under the legislative e-mail and privilege exemptions.",
          "relevance": "The controlling Delaware statement that a withholding agency, not the requester, bears the burden of justifying nondisclosure.",
          "quote": "Regardless of who reviews the requestor's petition, the burden of proof is on the public body to demonstrate that its \"reasons\" for withholding records were sufficient.",
          "url": "https://www.courtlistener.com/opinion/4417294/flowers-jr-v-office-of-the-governor/",
          "courtlistener_cluster_id": 4417294
        }
      ],
