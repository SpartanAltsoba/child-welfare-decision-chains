      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Department of Services for Children, Youth, & Their Families v. Garcias",
          "citation": "92 A.3d 1072 (Del. Fam. Ct. 2013)",
          "court": "Delaware Family Court",
          "year": 2013,
          "date_decided": "2013-12-03",
          "holding": "The Family Court terminated both parents' rights, holding that DFS proved by clear and convincing evidence the mother's failure to plan, the father's abandonment, and that the Division had made reasonable efforts to reunify the family.",
          "relevance": "Shows the judicial reasonable-efforts determination on which Title IV-E federal reimbursement depends.",
          "quote": "Given the importance of the rights at stake and the permanent nature of this proceeding, DFS must prove these elements by clear and convincing evidence.",
          "url": "https://www.courtlistener.com/opinion/5147938/department-of-services-for-children-youth-their-families-v-garcias/",
          "courtlistener_cluster_id": 5147938
        },
        {
          "case_name": "In re Burns",
          "citation": "519 A.2d 638 (Del. 1986)",
          "court": "Supreme Court of Delaware",
          "year": 1986,
          "date_decided": "1986-12-19",
          "holding": "The Court reversed the termination of a young mother's parental rights and returned custody of her son to her, holding that requiring an unrepresented minor to sign a voluntary placement agreement as the price of housing assistance, followed by an ex parte custody order entered without the notice the rules required, fell below minimum due process, and that the agencies' failure to provide meaningful case plans or make reasonable efforts to prevent removal and reunify the family independently vitiated the judgment.",
          "relevance": "Delaware's leading statement of what Titles IV-B and IV-E demand of the State - meaningful case plans and affirmative preventive and reunification services - as the price of federal funds.",
          "quote": "DCPS must prove by clear and convincing evidence that termination of parental rights is essential to the child's welfare.",
          "url": "https://www.courtlistener.com/opinion/1516637/matter-of-burns/",
          "courtlistener_cluster_id": 1516637
        },
        {
          "case_name": "Suter v. Artist M.",
          "citation": "503 U.S. 347 (1992)",
          "court": "Supreme Court of the United States",
          "year": 1992,
          "date_decided": "1992-03-25",
          "holding": "Reversing the Seventh Circuit, the Supreme Court held that the Adoption Assistance and Child Welfare Act's requirement that a State make reasonable efforts to prevent removal and to reunify families imposes only a generalized duty, enforceable by the Secretary through the plan-approval process, and confers no privately enforceable right under section 1983 and no implied cause of action.",
          "relevance": "The controlling federal rule that a State's failure to meet Title IV-E plan requirements is corrected through the Secretary's funding oversight rather than by private litigation.",
          "quote": "We conclude that 42 U. S. C. § 671 (a)(15) neither confers an enforceable private right on its beneficiaries nor creates an implied cause of action on their behalf.",
          "url": "https://www.courtlistener.com/opinion/112712/suter-v-artist-m/",
          "courtlistener_cluster_id": 112712
        }
      ],
