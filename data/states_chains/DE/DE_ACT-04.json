      "verified_date": "2026-09-20",
      "key_cases": [
        {
          "case_name": "Stewart v. Department of Services for Children, Youth, & Their Families",
          "citation": "991 A.2d 750 (Del. 2010)",
          "court": "Supreme Court of Delaware",
          "year": 2010,
          "date_decided": "2010-03-16",
          "holding": "Affirming termination and the denial of two relatives' guardianship petitions, the Court held that a guardianship petitioner must show by a preponderance both that the child is dependent or neglected and that guardianship is in the child's best interests, and that DFS made appropriate reunification services available to a mother with mental disabilities.",
          "relevance": "States the two-element preponderance test a relative must satisfy to obtain guardianship over the agency's objection.",
          "quote": "To grant a guardianship petition, two factors must be shown by the preponderance of the evidence",
          "url": "https://www.courtlistener.com/opinion/2273628/stewart-v-department-of-services-for-children-youth-their-families/",
          "courtlistener_cluster_id": 2273628
        },
        {
          "case_name": "Clark v. Division of Family Services",
          "citation": "975 A.2d 813 (Del. 2009)",
          "court": "Supreme Court of Delaware",
          "year": 2009,
          "date_decided": "2009-06-25",
          "holding": "The Court affirmed termination, holding that the mother's conviction of a felony-level offense against a child under 13 Del. C. section 1103(a)(4) independently satisfied the statutory-ground step of the required two-step analysis, so the failure-to-plan ground need not be reached.",
          "relevance": "Decided alongside relatives' competing guardianship petitions, illustrating how kinship options are weighed against termination.",
          "quote": "Before terminating a parent's rights in a child, the Family Court must engage in a two-step analysis.",
          "url": "https://www.courtlistener.com/opinion/1886607/clark-v-division-of-family-services/",
          "courtlistener_cluster_id": 1886607
        },
        {
          "case_name": "In re Hanks",
          "citation": "553 A.2d 1171 (Del. 1989)",
          "court": "Supreme Court of Delaware",
          "year": 1989,
          "date_decided": "1989-01-20",
          "holding": "The Court affirmed the termination of a chronically mentally ill mother's parental rights, holding that the words \"plan\" and \"adequately\" in the failure-to-plan ground of 13 Del. C. section 1103(5) are not unconstitutionally vague, that the State had made repeated attempts to preserve the family before seeking termination, and that the record supported the Family Court's best-interest determination under the 13 Del. C. section 722(a) factors.",
          "relevance": "Shows the agency's second case plan directed at placing the children with the mother's relatives, and what follows when that kinship option fails.",
          "quote": "In addition, judicial decisions clearly indicate that termination, to be lawful, must be in the child's best interests.",
          "url": "https://www.courtlistener.com/opinion/2059794/in-re-hanks/",
          "courtlistener_cluster_id": 2059794
        }
      ],
