          "courtlistener_cluster_id": 533797
        },
        {
          "case_name": "Croft v. Westmoreland County Children and Youth Services",
          "citation": "103 F.3d 1123 (3d Cir. 1997)",
          "court": "United States Court of Appeals for the Third Circuit",
          "year": 1997,
          "date_decided": "1997-01-06",
          "holding": "The Third Circuit reversed summary judgment for the caseworker, holding that a caseworker who lacked objectively reasonable grounds to believe a child had been abused or was in imminent danger violated the family's Fourteenth Amendment liberty interest by forcing the father to leave the home under threat of removal.",
          "relevance": "Confirms that police involvement does not relieve the agency of needing objectively reasonable grounds before separating a family.",
          "quote": "Even considered together, minor inconsistencies which provide no affirmative evidence of sexual abuse cannot alone establish the objectively reasonable grounds necessary to remove a family member from the family unit.",
          "url": "https://www.courtlistener.com/opinion/732428/croft-v-westmoreland-county-children-and-youth-services/",
          "courtlistener_cluster_id": 732428
        },
        {
          "case_name": "Miller v. City of Philadelphia",
          "citation": "174 F.3d 368 (3d Cir. 1999)",
          "court": "United States Court of Appeals for the Third Circuit",
          "year": 1999,
          "date_decided": "1999-04-26",
          "holding": "The Third Circuit affirmed judgment for the child-welfare caseworker, holding that a substantive due process claim arising from a child-welfare intervention requires executive conduct that shocks the conscience, a standard that negligence cannot meet.",
          "relevance": "Sets the fault standard for constitutional claims arising out of coordinated agency and law-enforcement intervention.",
          "quote": "Critically, under this standard, officials will not be held liable for actions that are merely negligent.",
          "url": "https://www.courtlistener.com/opinion/763470/miller-v-city-of-philadelphia/",
          "courtlistener_cluster_id": 763470
        }
