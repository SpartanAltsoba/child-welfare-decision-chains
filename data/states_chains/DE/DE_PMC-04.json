          "courtlistener_cluster_id": 112202
        },
        {
          "case_name": "Hunt v. Division of Family Services",
          "citation": "146 A.3d 1051 (Del. 2015)",
          "court": "Supreme Court of Delaware",
          "year": 2015,
          "date_decided": "2015-09-16",
          "holding": "On expedited interlocutory appeal the Court affirmed, holding that the Family Court's statutory authority to consent to medical care for a child in DFS custody carries with it the authority to de-escalate treatment and withdraw life support, and that both parents received procedural due process.",
          "relevance": "A case of catastrophic non-accidental injury under court supervision, the fact pattern fatality review is meant to capture.",
          "quote": "Accordingly, we hold that the Family Court's authority to de-escalate medical treatment and to withdraw life support is a logical corollary to its statutory authority to consent to medical care.",
          "url": "https://www.courtlistener.com/opinion/2959591/hunt-v-division-of-family-services/",
          "courtlistener_cluster_id": 2959591
        },
        {
          "case_name": "Nicini v. Morra",
          "citation": "212 F.3d 798 (3d Cir. 2000)",
          "court": "United States Court of Appeals for the Third Circuit",
          "year": 2000,
          "date_decided": "2000-05-19",
          "holding": "Sitting en banc, the Third Circuit held that when the State places a child in state-regulated foster care it enters a special relationship with that child carrying affirmative constitutional duties enforceable under section 1983, but affirmed judgment for the caseworker because his investigation of the placement amounted at most to negligence and did not satisfy the deliberate indifference standard.",
          "relevance": "Defines the constitutional duty whose breach a fatality or serious-injury review of a child in care is actually measuring.",
          "quote": "when the state places a child in state-regulated foster care, the state has entered into a special relationship with that child which imposes upon it certain affirmative duties",
          "url": "https://www.courtlistener.com/opinion/768726/nicini-v-morra/",
          "courtlistener_cluster_id": 768726
        }
