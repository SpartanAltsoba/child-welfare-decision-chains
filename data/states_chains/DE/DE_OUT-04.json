        {
          "case_name": "Suter v. Artist M.",
          "citation": "503 U.S. 347 (1992)",
          "court": "Supreme Court of the United States",
          "year": 1992,
          "date_decided": "1992-03-25",
          "holding": "Reversing the Seventh Circuit, the Supreme Court held that the Adoption Assistance and Child Welfare Act's requirement that a State make reasonable efforts to prevent removal and to reunify families imposes only a generalized duty, enforceable by the Secretary through the plan-approval process, and confers no privately enforceable right under section 1983 and no implied cause of action.",
          "relevance": "Explains why a youth seeking continued or extended federally funded foster-care and transition services has no private federal cause of action to compel them.",
          "quote": "We conclude that 42 U. S. C. § 671 (a)(15) neither confers an enforceable private right on its beneficiaries nor creates an implied cause of action on their behalf.",
          "url": "https://www.courtlistener.com/opinion/112712/suter-v-artist-m/",
          "courtlistener_cluster_id": 112712
        }
